{
  "name": "@bendyline/molen-entities",
  "version": "0.0.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Molen entity library: ids and helpers for the molen.entities content pack (trees, rocks, aircraft, vehicles)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendyline/molen.git",
    "directory": "packages/entities"
  },
  "homepage": "https://github.com/bendyline/molen/tree/main/packages/entities",
  "bugs": {
    "url": "https://github.com/bendyline/molen/issues"
  },
  "keywords": [
    "molen",
    "3d",
    "gltf",
    "assets",
    "entity-library"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate-models.mjs",
    "build": "tsdown && node scripts/generate-models.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check src scripts test package.json",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bendyline/molen-kernel": "workspace:*",
    "@bendyline/molen-schema": "workspace:*"
  },
  "devDependencies": {
    "@bendyline/molen-pack": "workspace:*",
    "@biomejs/biome": "^2.5.0",
    "three": "0.184.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
