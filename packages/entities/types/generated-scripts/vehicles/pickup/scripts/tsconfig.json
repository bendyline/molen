{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["*.ts", "*.js"]
}
