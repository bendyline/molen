{
  "format": "molen/archstyle@1",
  "id": "molen.worldgen.generic.commercial",
  "title": "Generic commercial block",
  "doc": "Commercial blocks with one window row per storey, full-size ground-floor glazing and solid spandrels. Missing heights on untyped buildings and low-rise uses default conservatively to one or two storeys; explicit offices and supplied metrics retain taller massing.",
  "version": 1,
  "applicability": {
    "classes": [
      "commercial",
      "office",
      "retail",
      "hotel",
      "apartments",
      "industrial",
      "warehouse",
      "school",
      "hospital",
      "university",
      "public",
      "civic",
      "government",
      "church",
      "supermarket",
      "yes",
      "building"
    ]
  },
  "massing": {
    "floorHeight": {
      "min": 3.6,
      "max": 4.2
    },
    "groundFloorHeight": {
      "min": 4.5,
      "max": 5.5
    },
    "heightFallback": [
      {
        "when": {
          "class": [
            "yes",
            "building",
            "commercial",
            "retail",
            "industrial",
            "warehouse",
            "supermarket",
            "school",
            "kindergarten"
          ]
        },
        "levels": {
          "min": 1,
          "max": 2
        }
      },
      {
        "when": {
          "areaMax": 400
        },
        "levels": {
          "min": 1,
          "max": 2
        }
      },
      {
        "when": {
          "areaMax": 1500
        },
        "levels": {
          "min": 2,
          "max": 4
        }
      },
      {
        "levels": {
          "min": 3,
          "max": 6
        }
      }
    ],
    "groundFit": "platform-average",
    "foundation": {
      "height": {
        "min": 0.3,
        "max": 0.6
      },
      "exposeOnSlope": true
    },
    "wings": {
      "split": "none",
      "maxWingSpan": 18,
      "minWingArea": 40,
      "secondaryHeightScale": {
        "min": 1,
        "max": 1
      }
    },
    "setbacks": [
      {
        "aboveHeight": 40,
        "inset": 3
      }
    ],
    "respectMinHeight": true
  },
  "roof": {
    "perWing": false,
    "ridge": "long-axis",
    "overhang": {
      "min": 0,
      "max": 0.1
    },
    "complexFootprint": "flat",
    "choices": [
      {
        "type": "flat",
        "weight": 10,
        "parapet": {
          "height": {
            "min": 0.6,
            "max": 1.2
          },
          "thickness": 0.4
        }
      },
      {
        "type": "hip",
        "weight": 1,
        "pitchDeg": {
          "min": 15,
          "max": 22
        },
        "when": {
          "areaMax": 500
        }
      }
    ],
    "fallback": "flat"
  },
  "facade": {
    "bays": {
      "width": {
        "min": 3.5,
        "max": 5
      },
      "cornerMargin": 0.8
    },
    "windows": {
      "style": "grid",
      "width": {
        "min": 1.6,
        "max": 2.4
      },
      "height": {
        "min": 2.8,
        "max": 3.4
      },
      "sill": {
        "min": 0.8,
        "max": 1
      },
      "probabilityPerBay": 0.95,
      "groundFloor": "storefront"
    },
    "bands": {
      "base": {
        "height": {
          "min": 0.4,
          "max": 0.7
        }
      },
      "floorLines": true,
      "cornice": {
        "height": 0.3
      }
    }
  },
  "materials": {
    "wall": {
      "choices": [
        {
          "ref": "matgraph:molen.worldgen.material.concrete_panel",
          "weight": 3
        },
        {
          "ref": "matgraph:molen.worldgen.material.brick",
          "weight": 2
        },
        {
          "ref": "matgraph:molen.worldgen.material.stucco",
          "weight": 1
        }
      ],
      "palette": "wall",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [3, 3],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "roof": {
      "choices": [
        {
          "ref": "matgraph:molen.worldgen.material.membrane",
          "weight": 3
        },
        {
          "ref": "matgraph:molen.worldgen.material.gravel",
          "weight": 1
        }
      ],
      "palette": "roof",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [4, 4],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "trim": {
      "choices": [
        {
          "ref": "palette:#ffffff",
          "weight": 1
        }
      ],
      "palette": "trim",
      "tint": "multiply",
      "uv": "meters",
      "uvOffset": "none",
      "uvMirror": false
    },
    "foundation": {
      "choices": [
        {
          "ref": "matgraph:molen.worldgen.material.concrete_plain",
          "weight": 1
        }
      ],
      "palette": "foundation",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [2, 2],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "window": {
      "choices": [
        {
          "ref": "matgraph:molen.worldgen.material.window_grid",
          "weight": 1
        }
      ],
      "tint": "none",
      "uv": "cell",
      "uvOffset": "none",
      "uvMirror": false
    }
  },
  "palettes": {
    "wall": {
      "entries": [
        {
          "color": "#b8b3ab",
          "weight": 3,
          "name": "concrete"
        },
        {
          "color": "#9c8f84",
          "weight": 2,
          "name": "warm panel"
        },
        {
          "color": "#8a5a48",
          "weight": 2,
          "name": "brick"
        },
        {
          "color": "#d9d5cd",
          "weight": 2,
          "name": "light panel"
        },
        {
          "color": "#5d6470",
          "weight": 1,
          "name": "steel blue"
        }
      ],
      "jitter": {
        "hue": 0.01,
        "saturation": 0.04,
        "lightness": 0.06
      }
    },
    "roof": {
      "entries": [
        {
          "color": "#8b8b88",
          "weight": 3,
          "name": "gravel"
        },
        {
          "color": "#a9a7a1",
          "weight": 1,
          "name": "membrane"
        }
      ],
      "jitter": {
        "hue": 0,
        "saturation": 0.02,
        "lightness": 0.04
      }
    },
    "trim": {
      "entries": [
        {
          "color": "#2b2b2b",
          "weight": 3
        },
        {
          "color": "#6e6e6e",
          "weight": 1
        }
      ],
      "jitter": {
        "hue": 0,
        "saturation": 0,
        "lightness": 0.04
      }
    },
    "foundation": {
      "entries": [
        {
          "color": "#7d7b77",
          "weight": 1
        }
      ],
      "jitter": {
        "hue": 0,
        "saturation": 0.02,
        "lightness": 0.04
      }
    }
  },
  "props": [
    {
      "id": "hvac",
      "model": "molen.worldgen.prop.rooftop.hvac",
      "anchor": "roof-flat",
      "probability": 0.85,
      "count": {
        "min": 1,
        "max": 6
      },
      "perAreaM2": 300,
      "roof": ["flat"],
      "spacing": 4,
      "margin": 2,
      "scale": {
        "min": 0.9,
        "max": 1.3
      },
      "yaw": "align-wall",
      "lodTier": 0
    }
  ],
  "lod": {
    "tiers": [
      {
        "minTier": 0,
        "keep": ["roof-shape", "roof-features", "facade-texture", "facade-bands", "props"]
      },
      {
        "minTier": 1,
        "keep": ["roof-shape", "facade-texture"]
      },
      {
        "minTier": 2,
        "keep": ["roof-shape"]
      }
    ]
  }
}
