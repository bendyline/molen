{
  "format": "molen/archstyle@1",
  "id": "molen.worldgen.catalog.railway_station",
  "title": "Small railway station",
  "doc": "Long masonry station with an offset central wing and a deep canopy along the platform frontage. Parametric interpretation: outline, height, floor count and seed remain caller-controlled; large or unusually tall outlines use a compatible flat-roof fallback.",
  "version": 1,
  "applicability": {
    "classes": ["railway_station", "train_station"],
    "areaMin": 12,
    "notes": "Regional precedent is descriptive; explicit style requests work in every world."
  },
  "massing": {
    "floorHeight": { "min": 3.3, "max": 3.5 },
    "heightFallback": [{ "levels": { "min": 2, "max": 2 } }],
    "groundFit": "platform-average",
    "foundation": { "height": { "min": 0.3, "max": 0.4 }, "exposeOnSlope": true },
    "wings": {
      "split": "rectangles",
      "maxWingSpan": 20,
      "minWingArea": 5,
      "secondaryHeightScale": { "min": 1, "max": 1 }
    },
    "setbacks": [],
    "respectMinHeight": true
  },
  "roof": {
    "perWing": true,
    "ridge": "long-axis",
    "overhang": { "min": 0.45, "max": 0.45 },
    "complexFootprint": "wings",
    "choices": [
      {
        "type": "hip",
        "weight": 1,
        "pitchDeg": { "min": 32, "max": 34 },
        "when": { "levelsMax": 3 }
      },
      {
        "type": "flat",
        "weight": 1,
        "parapet": { "height": { "min": 0.4, "max": 0.4 }, "thickness": 0.24 },
        "when": { "levelsMin": 4 }
      }
    ],
    "fallback": "flat"
  },
  "facade": {
    "bays": { "width": { "min": 3.42, "max": 3.58 }, "cornerMargin": 0.5 },
    "windows": {
      "style": "punched",
      "width": { "min": 1.12, "max": 1.18 },
      "height": { "min": 1.32, "max": 1.38 },
      "sill": { "min": 0.82, "max": 0.82 },
      "probabilityPerBay": 1,
      "groundFloor": "same"
    },
    "bands": {
      "base": { "height": { "min": 0.32, "max": 0.32 } },
      "floorLines": false,
      "cornice": { "height": 0.16 }
    },
    "details": {
      "framing": { "style": "pilasters", "width": 0.23 },
      "veranda": { "depth": 2.2, "columns": true }
    }
  },
  "materials": {
    "wall": {
      "choices": [{ "ref": "matgraph:molen.worldgen.material.brick", "weight": 1 }],
      "palette": "wall",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [1.92, 0.9],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "roof": {
      "choices": [{ "ref": "matgraph:molen.worldgen.material.slate", "weight": 1 }],
      "palette": "roof",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [1.5, 1.6],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "trim": {
      "choices": [{ "ref": "palette:#ffffff", "weight": 1 }],
      "palette": "trim",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [2, 2],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "foundation": {
      "choices": [{ "ref": "matgraph:molen.worldgen.material.stone", "weight": 1 }],
      "palette": "foundation",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [2, 2],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "window": {
      "choices": [{ "ref": "matgraph:molen.worldgen.material.window_punched", "weight": 1 }],
      "tint": "none",
      "uv": "cell",
      "uvOffset": "none",
      "uvMirror": false
    }
  },
  "palettes": {
    "wall": {
      "entries": [{ "color": "#c29b77", "weight": 1 }],
      "jitter": { "hue": 0.008, "saturation": 0.025, "lightness": 0.025 }
    },
    "roof": {
      "entries": [{ "color": "#727b81", "weight": 1 }],
      "jitter": { "hue": 0.008, "saturation": 0.025, "lightness": 0.025 }
    },
    "trim": {
      "entries": [{ "color": "#dfd7c2", "weight": 1 }],
      "jitter": { "hue": 0.008, "saturation": 0.025, "lightness": 0.025 }
    },
    "foundation": {
      "entries": [{ "color": "#b4aa93", "weight": 1 }],
      "jitter": { "hue": 0.008, "saturation": 0.025, "lightness": 0.025 }
    }
  },
  "props": [],
  "lod": {
    "tiers": [
      {
        "minTier": 0,
        "keep": ["roof-shape", "roof-features", "facade-texture", "facade-bands", "props"]
      },
      { "minTier": 1, "keep": ["roof-shape", "facade-texture", "facade-bands"] },
      { "minTier": 2, "keep": ["roof-shape"] }
    ]
  }
}
