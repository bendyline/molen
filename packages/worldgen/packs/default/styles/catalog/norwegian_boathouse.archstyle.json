{
  "format": "molen/archstyle@1",
  "id": "molen.worldgen.catalog.norwegian_boathouse",
  "title": "Norwegian boathouse",
  "doc": "Elongated waterfront store with vertical timber boards, a high gable and sparse small windows. Parametric interpretation: outline, height, floor count and seed remain caller-controlled; large or unusually tall outlines use a compatible flat-roof fallback.",
  "version": 1,
  "applicability": {
    "classes": ["norwegian_boathouse", "boathouse"],
    "areaMin": 12,
    "notes": "Regional precedent is descriptive; explicit style requests work in every world."
  },
  "massing": {
    "floorHeight": { "min": 3.3, "max": 3.5 },
    "heightFallback": [{ "levels": { "min": 1, "max": 1 } }],
    "groundFit": "platform-average",
    "foundation": { "height": { "min": 0.3, "max": 0.4 }, "exposeOnSlope": true },
    "wings": {
      "split": "rectangles",
      "maxWingSpan": 20,
      "minWingArea": 5,
      "secondaryHeightScale": { "min": 1, "max": 1 }
    },
    "setbacks": [],
    "respectMinHeight": true
  },
  "roof": {
    "perWing": true,
    "ridge": "long-axis",
    "overhang": { "min": 0.45, "max": 0.45 },
    "complexFootprint": "wings",
    "choices": [
      {
        "type": "gable",
        "weight": 1,
        "pitchDeg": { "min": 39, "max": 41 },
        "when": { "levelsMax": 3 }
      },
      {
        "type": "flat",
        "weight": 1,
        "parapet": { "height": { "min": 0.4, "max": 0.4 }, "thickness": 0.24 },
        "when": { "levelsMin": 4 }
      }
    ],
    "fallback": "flat"
  },
  "facade": {
    "bays": { "width": { "min": 3.92, "max": 4.08 }, "cornerMargin": 0.5 },
    "windows": {
      "style": "punched",
      "width": { "min": 1.12, "max": 1.18 },
      "height": { "min": 1.32, "max": 1.38 },
      "sill": { "min": 0.82, "max": 0.82 },
      "probabilityPerBay": 0.35,
      "groundFloor": "same"
    },
    "bands": {
      "base": { "height": { "min": 0.32, "max": 0.32 } },
      "floorLines": false,
      "cornice": { "height": 0.16 }
    },
    "details": { "framing": { "style": "timber", "width": 0.17 } }
  },
  "materials": {
    "wall": {
      "choices": [{ "ref": "matgraph:molen.worldgen.material.wood_board_batten", "weight": 1 }],
      "palette": "wall",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [1.8, 2],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "roof": {
      "choices": [{ "ref": "matgraph:molen.worldgen.material.metal_standing_seam", "weight": 1 }],
      "palette": "roof",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [2.5, 3],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "trim": {
      "choices": [{ "ref": "palette:#ffffff", "weight": 1 }],
      "palette": "trim",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [2, 2],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "foundation": {
      "choices": [{ "ref": "matgraph:molen.worldgen.material.stone", "weight": 1 }],
      "palette": "foundation",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [2, 2],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "window": {
      "choices": [{ "ref": "matgraph:molen.worldgen.material.window_punched", "weight": 1 }],
      "tint": "none",
      "uv": "cell",
      "uvOffset": "none",
      "uvMirror": false
    }
  },
  "palettes": {
    "wall": {
      "entries": [{ "color": "#b46a50", "weight": 1 }],
      "jitter": { "hue": 0.008, "saturation": 0.025, "lightness": 0.025 }
    },
    "roof": {
      "entries": [{ "color": "#839390", "weight": 1 }],
      "jitter": { "hue": 0.008, "saturation": 0.025, "lightness": 0.025 }
    },
    "trim": {
      "entries": [{ "color": "#70624e", "weight": 1 }],
      "jitter": { "hue": 0.008, "saturation": 0.025, "lightness": 0.025 }
    },
    "foundation": {
      "entries": [{ "color": "#b4aa93", "weight": 1 }],
      "jitter": { "hue": 0.008, "saturation": 0.025, "lightness": 0.025 }
    }
  },
  "props": [],
  "lod": {
    "tiers": [
      {
        "minTier": 0,
        "keep": ["roof-shape", "roof-features", "facade-texture", "facade-bands", "props"]
      },
      { "minTier": 1, "keep": ["roof-shape", "facade-texture", "facade-bands"] },
      { "minTier": 2, "keep": ["roof-shape"] }
    ]
  }
