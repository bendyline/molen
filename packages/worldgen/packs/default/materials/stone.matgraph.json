{
  "format": "molen/matgraph@1",
  "size": [256, 256],
  "seed": 21,
  "nodes": [
    { "id": "cells", "type": "worley", "params": { "scale": 7, "jitter": 1, "output": "f2-f1" } },
    {
      "id": "joints",
      "type": "threshold",
      "input": "cells",
      "params": { "edge": 0.12, "smoothness": 0.04 }
    },
    {
      "id": "blocks",
      "type": "ramp",
      "input": "joints",
      "params": { "stops": [{ "t": 0, "color": "#a29d94" }, { "t": 1, "color": "#e2ded5" }] }
    },
    {
      "id": "grain-noise",
      "type": "noise",
      "params": { "kind": "simplex", "octaves": 3, "scale": 9, "seedOffset": 9 }
    },
    {
      "id": "grain",
      "type": "levels",
      "input": "grain-noise",
      "params": { "outMin": 0.82, "outMax": 1 }
    },
    {
      "id": "out",
      "type": "blend",
      "inputs": { "a": "blocks", "b": "grain" },
      "params": { "mode": "multiply", "factor": 1 }
    },
    { "id": "rough", "type": "const", "params": { "value": 0.88 } }
  ],
  "outputs": { "baseColor": "out", "roughness": "rough" }
}
