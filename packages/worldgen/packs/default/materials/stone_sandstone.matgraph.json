{
  "format": "molen/matgraph@1",
  "size": [256, 256],
  "seed": 122,
  "nodes": [
    {
      "id": "joints",
      "type": "bricks",
      "params": { "rows": 6, "cols": 3, "mortarWidth": 0.04, "offset": 0.5 }
    },
    {
      "id": "blocks",
      "type": "ramp",
      "input": "joints",
      "params": {
        "stops": [
          { "t": 0, "color": "#bdb09b" },
          { "t": 0.5, "color": "#bdb09b" },
          { "t": 0.56, "color": "#f0e3cb" },
          { "t": 1, "color": "#f0e3cb" }
        ]
      }
    },
    { "id": "u", "type": "gradient", "params": { "kind": "linear", "angleDeg": 0 } },
    { "id": "v", "type": "gradient", "params": { "kind": "linear", "angleDeg": 90 } },
    {
      "id": "u-fold",
      "type": "ramp",
      "input": "u",
      "params": {
        "stops": [
          { "t": 0, "color": "#000000" },
          { "t": 0.5, "color": "#ff0000" },
          { "t": 1, "color": "#000000" }
        ]
      }
    },
    {
      "id": "v-fold",
      "type": "ramp",
      "input": "v",
      "params": {
        "stops": [
          { "t": 0, "color": "#000000" },
          { "t": 0.5, "color": "#00ff00" },
          { "t": 1, "color": "#000000" }
        ]
      }
    },
    {
      "id": "fold",
      "type": "blend",
      "inputs": { "a": "u-fold", "b": "v-fold" },
      "params": { "mode": "add", "factor": 1 }
    },
    { "id": "stretch", "type": "const", "params": { "value": [0.07894736842105263, 1, 0, 1] } },
    {
      "id": "fiber-uv",
      "type": "blend",
      "inputs": { "a": "fold", "b": "stretch" },
      "params": { "mode": "multiply", "factor": 1 }
    },
    {
      "id": "fiber-noise",
      "type": "noise",
      "params": { "kind": "simplex", "octaves": 2, "scale": 38, "seedOffset": 31 },
      "input": "fiber-uv"
    },
    {
      "id": "fiber",
      "type": "levels",
      "input": "fiber-noise",
      "params": { "outMin": 0.85, "outMax": 1 }
    },
    {
      "id": "out",
      "type": "blend",
      "inputs": { "a": "blocks", "b": "fiber" },
      "params": { "mode": "multiply", "factor": 1 }
    },
    { "id": "rough", "type": "const", "params": { "value": 0.96 } },
    {
      "id": "normal",
      "type": "height-to-normal",
      "input": "joints",
      "params": { "strength": 0.009 }
    }
  ],
  "outputs": { "baseColor": "out", "roughness": "rough", "normal": "normal" }
}
