{
  "name": "@bendyline/molen-examples-lantern-dungeon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5225",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "biome check src test",
    "test:unit": "vitest run --passWithNoTests --exclude \"test/golden/**\"",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "assets:generate": "python tools/generate-assets.py",
    "assets:check": "python tools/generate-assets.py --check",
    "assets:import": "node tools/import-assets.mjs && biome format --write project.json asset-gallery.json asset-src/import-report.json public/assets",
    "assets:shot": "node tools/capture-assets.mjs",
    "predev": "pnpm --filter \"@bendyline/molen-examples-lantern-dungeon^...\" build",
    "preview": "vite preview",
    "assets:verify": "node tools/verify-assets.mjs"
  },
  "dependencies": {
    "@bendyline/molen-client": "workspace:*",
    "@bendyline/molen-kernel": "workspace:*",
    "@bendyline/molen-schema": "workspace:*",
    "@bendyline/molen-tooling": "workspace:*",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24",
    "@types/three": "0.184.0",
    "typescript": "catalog:",
    "vite": "^6.4.0",
    "vitest": "catalog:"
  }
}
