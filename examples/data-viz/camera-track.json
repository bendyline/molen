{
  "format": "molen/cameratrack@1",
  "easing": "smooth",
  "loop": true,
  "keyframes": [
    { "tick": 0, "position": [0, 10, 22], "lookAt": [0, 4, 0] },
    { "tick": 60, "position": [22, 12, 0], "lookAt": [0, 4, 0] },
    { "tick": 120, "position": [0, 16, -22], "lookAt": [0, 4, 0] },
    { "tick": 180, "position": [-22, 12, 0], "lookAt": [0, 4, 0] },
    { "tick": 240, "position": [0, 10, 22], "lookAt": [0, 4, 0] }
  ]
}
