{
  "format": "molen/experience-play@1",
  "name": "Mount Baker tunnel flight",
  "path": "/?lat=47.590063&lon=-122.28835&alt=36&yaw=3.141592653589793&pitch=0&quality=economy&backend=webgl&freeze&ambient=0&nostyles&hud=0",
  "viewport": [1280, 720],
  "probes": [
    { "name": "location", "selector": "#location" },
    { "name": "status", "selector": "#status" }
  ],
  "actions": [
    { "type": "click", "selector": "button[data-mode=\"human\"]" },
    {
      "type": "wait-for-stable",
      "selector": "#status",
      "text": "0 loading layers",
      "stableMs": 600,
      "timeoutMs": 240000
    },
    { "type": "screenshot", "name": "01-portal", "timeoutMs": 120000 },
    { "type": "key-down", "keys": ["w", "Shift"] },
    {
      "type": "wait-for",
      "note": "Fly until the camera is past -122.289 (about 50 m west; the bore opens about 21 m west), not for a fixed time: a software-rendered frame advances at most 4.2 m because dt is capped at 0.1 s, and CI rendered only two frames in an 8 s hold.",
      "selector": "#location:text-matches(\"Lon -122[.]2(?:89|9)\")",
      "timeoutMs": 240000
    },
    { "type": "key-up", "keys": ["w", "Shift"] },
    {
      "type": "wait-for-stable",
      "selector": "#status",
      "text": "0 loading layers",
      "stableMs": 500,
      "timeoutMs": 240000
    },
    { "type": "screenshot", "name": "02-inside", "timeoutMs": 120000 }
  ]
}
