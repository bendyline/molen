{
  "format": "molen/experience-play@1",
  "name": "world-explorer-walk-mode",
  "path": "/?synthetic=1&lineup=1&quality=economy&freeze=1&lat=47.62145000&lon=-122.01290236&alt=415&yaw=-1.5708&style=none",
  "viewport": [1280, 720],
  "probes": [
    {
      "name": "navigation",
      "selector": "#navigation-status"
    },
    {
      "name": "status",
      "selector": "#status"
    },
    {
      "name": "location",
      "selector": "#location"
    }
  ],
  "actions": [
    {
      "type": "wait-for-stable",
      "note": "Economy quality: this scenario reads the HUD, not pixels, and software rendering draws a balanced frame about 8 times slower (1.5-2.8 s against 0.2 s), which starved everything that advances per frame: driving, walking, climbing.",
      "selector": "#status",
      "text": "0 loading layers",
      "stableMs": 800,
      "timeoutMs": 240000
    },
    {
      "type": "click",
      "selector": "button[data-navigation=\"walk\"]"
    },
    {
      "type": "wait-for-stable",
      "selector": "#navigation-status",
      "text": "On ground",
      "stableMs": 500,
      "timeoutMs": 240000
    },
    {
      "type": "screenshot",
      "name": "01-walk-human-scale",
      "timeoutMs": 120000
    },
    {
      "type": "click",
      "selector": "button[data-mode=\"bare\"]"
    },
    {
      "type": "wait",
      "durationMs": 600
    },
    {
      "type": "screenshot",
      "name": "02-bare-before-walk",
      "timeoutMs": 120000
    },
    {
      "type": "click",
      "selector": "button[data-navigation=\"walk\"]"
    },
    {
      "type": "key-down",
      "keys": ["w"]
    },
    {
      "type": "wait",
      "durationMs": 3000
    },
    {
      "type": "wait-for",
      "note": "Keep walking until the camera has moved: a CI software frame can outlast the 3 s hold. Wait on the start latitude to the 5 decimals the test compares (#location shows 7 and stays visible while walking, unlike #status); it comes from the path.",
      "selector": "#location:not(:has-text(\"Lat 47.62145\"))",
      "timeoutMs": 240000
    },
    {
      "type": "key-up",
      "keys": ["w"]
    },
    {
      "type": "wait",
      "durationMs": 500
    },
    {
      "type": "screenshot",
      "name": "02-walk-forward",
      "timeoutMs": 120000
    },
    {
      "type": "keys",
      "keys": ["e"],
      "durationMs": 700
    },
    {
      "type": "screenshot",
      "name": "03-no-flight-on-foot",
      "timeoutMs": 120000
    },
    {
      "type": "key-down",
      "keys": ["Space"]
    },
    {
      "type": "wait-for",
      "selector": "#navigation-status",
      "text": "In air",
      "timeoutMs": 240000
    },
    {
      "type": "key-up",
      "keys": ["Space"]
    },
    {
      "type": "screenshot",
      "name": "04-jump",
      "settleMs": 0,
      "timeoutMs": 120000
    },
    {
      "type": "wait-for-stable",
      "selector": "#navigation-status",
      "text": "On ground",
      "stableMs": 500,
      "timeoutMs": 240000
    },
    {
      "type": "screenshot",
      "name": "05-landed",
      "timeoutMs": 120000
    },
    {
      "type": "click",
      "selector": "button[data-navigation=\"fly\"]"
    },
    {
      "type": "wait-for",
      "selector": "#navigation-status",
      "text": "Fly mode",
      "timeoutMs": 240000
    },
    {
      "type": "screenshot",
      "name": "06-fly",
      "timeoutMs": 120000
    }
  ]
}
