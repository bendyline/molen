{
  "format": "molen/scene@3",
  "name": "skybound",
  "seed": "skybound-1",
  "tickRate": 30,
  "physics": {
    "engine": "platformer"
  },
  "camera": {
    "mode": "follow",
    "entity": "camera-target",
    "offset": [0, 3, 22],
    "lookOffset": [0, 3, 0],
    "fov": 46
  },
  "components": {
    "skyGame": {
      "description": "Platform run, lives and checkpoint.",
      "examples": [
        {
          "status": "playing",
          "lives": 3,
          "coins": 0,
          "total": 15,
          "checkpoint": 0,
          "message": "Follow the floating seeds to the lighthouse."
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "lives": {
            "type": "number"
          },
          "coins": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "checkpoint": {
            "type": "number"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["status", "lives", "coins", "total", "checkpoint", "message"],
        "additionalProperties": false
      }
    },
    "seedPickup": {
      "description": "Collectible seed state.",
      "examples": [
        {
          "collected": false
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "collected": {
            "type": "boolean"
          }
        },
        "required": ["collected"],
        "additionalProperties": false
      }
    },
    "patrol": {
      "description": "Patrolling creature; stomp from above.",
      "examples": [
        {
          "left": 27,
          "right": 32,
          "direction": 1,
          "alive": true
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "left": {
            "type": "number"
          },
          "right": {
            "type": "number"
          },
          "direction": {
            "type": "number"
          },
          "alive": {
            "type": "boolean"
          }
        },
        "required": ["left", "right", "direction", "alive"],
        "additionalProperties": false
      }
    }
  },
  "commands": {
    "move": {
      "doc": "Horizontal movement; y ignored.",
      "payload": {
        "type": "object",
        "properties": {
          "dir": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": ["dir"],
        "additionalProperties": false
      }
    },
    "jump": {
      "doc": "Request a jump and set held state.",
      "payload": {
        "type": "object",
        "properties": {
          "held": {
            "type": "boolean"
          }
        },
        "required": ["held"],
        "additionalProperties": false
      }
    },
    "restart": {
      "doc": "Restart the whole level with three lives.",
      "payload": {
        "type": "object",
        "additionalProperties": false
      }
    }
  },
  "input": {
    "bindings": {
      "KeyA": "left",
      "ArrowLeft": "left",
      "KeyD": "right",
      "ArrowRight": "right",
      "KeyW": "up",
      "ArrowUp": "up",
      "KeyS": "down",
      "ArrowDown": "down",
      "Space": "jump",
      "KeyR": "restart"
    },
    "emit": [
      {
        "kind": "axis2d",
        "xNeg": "left",
        "xPos": "right",
        "yNeg": "up",
        "yPos": "down",
        "command": "move",
        "field": "dir"
      },
      {
        "kind": "press",
        "action": "jump",
        "command": "jump",
        "payload": {
          "held": true
        }
      },
      {
        "kind": "release",
        "action": "jump",
        "command": "jump",
        "payload": {
          "held": false
        }
      },
      {
        "kind": "press",
        "action": "restart",
        "command": "restart",
        "payload": {}
      }
    ]
  },
