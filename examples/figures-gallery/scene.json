{
  "format": "molen/scene@3",
  "name": "figures-gallery",
  "seed": "figures-gallery",
  "tickRate": 60,
  "keyframeInterval": 120,
  "camera": { "mode": "fixed", "position": [0, 3.4, 15], "lookAt": [0, 0.9, 0] },
  "input": {
    "bindings": { "Digit1": "idle", "Digit2": "walk", "Digit3": "run" },
    "emit": [
      { "kind": "press", "action": "idle", "command": "gait_idle" },
      { "kind": "press", "action": "walk", "command": "gait_walk" },
      { "kind": "press", "action": "run", "command": "gait_run" }
    ]
  },
  "commands": {
    "set_gait": {
      "doc": "Force every standing figure into a gait (idle clears the override).",
      "payload": {
        "type": "object",
        "properties": { "mode": { "type": "string", "enum": ["idle", "walk", "run"] } },
        "required": ["mode"],
        "additionalProperties": false
      }
    },
    "gait_idle": { "doc": "Clear the forced gait (key 1)." },
    "gait_walk": { "doc": "Walk in place (key 2)." },
    "gait_run": { "doc": "Run in place (key 3)." }
  },
  "scripts": [
    {
      "id": "gaits",
      "code": "function apply(mode) { for (const id of molen.query('figure').without('mounted').ids()) { if (mode === 'idle') { if (molen.has(id, 'figureIntent')) molen.remove(id, 'figureIntent'); } else { molen.set(id, 'figureIntent', { mode }); } } }\nmolen.onCommand('set_gait', (p) => apply(p.mode));\nmolen.onCommand('gait_idle', () => apply('idle'));\nmolen.onCommand('gait_walk', () => apply('walk'));\nmolen.onCommand('gait_run', () => apply('run'));"
    }
  ],
  "prefabs": {
    "figure": {
      "components": {
        "transform": { "pos": [0, 0, 0], "rot": [0, 0, 0, 1] },
        "renderable": {
          "kind": "figure",
          "ref": "procedural",
          "shadows": { "cast": true, "receive": true }
        }
      }
    }
  },
  "entities": [
    {
      "id": "sky",
      "components": {
        "environment": {
          "ambient": { "sky": "#dfe7ff", "ground": "#4a5240", "intensity": 1.0 },
          "sun": {
            "direction": [6, 12, 5],
            "color": "#fff4e0",
            "intensity": 1.6,
            "castShadow": true
          },
          "shadows": "medium"
        }
      }
    },
    {
      "id": "ground",
      "components": {
        "transform": { "pos": [0, -0.05, 0], "rot": [0, 0, 0, 1] },
        "renderable": {
          "kind": "primitive",
          "ref": "box",
          "materialRef": "palette:#6b7f5a",
          "primitive": { "size": [30, 0.1, 18] },
          "shadows": { "receive": true }
        }
      }
    },

    {
      "id": "child",
      "prefab": "figure",
      "components": {
        "transform": { "pos": [-6.5, 0, 1.5] },
        "figure": { "preset": "human.child" }
      }
    },
    {
      "id": "adult",
      "prefab": "figure",
      "components": {
        "transform": { "pos": [-4.6, 0, 1.5] },
        "figure": { "preset": "human.adult" }
