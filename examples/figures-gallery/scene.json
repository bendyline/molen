          "kind": "primitive",
          "ref": "cylinder",
          "materialRef": "palette:#39747d",
          "primitive": { "size": [0.32, 0.12, 0.32] },
          "shadows": { "cast": true }
        },
        "parent": { "id": "adult" },
        "figureAttachment": { "socket": "head.top", "offset": { "pos": [0, 0.06, 0] } }
