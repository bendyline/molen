{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-types",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.artifacts",
      "!review-lock.json",
      "!content/earth/fonts/*.json",
      "!content/glyphs-*/glyphs/*.json",
      "!**/__output__",
      "!**/.tmp",
      "!spikes",
      "!docs-site/.vitepress/cache",
      "!examples/*/public/packs",
      "!content/entities/gen",
      "!content/entities/types/generated-scripts",
      "!content/earth/source/signs/americana/*.svg",
      "!content/worldgen/source/places/**/reference-rights/**/*.html",
      "!content/worldgen/source/places/**/references/**/*.html",
      "!content/worldgen/source/places/**/map-sources/**/*.html",
      "!content/worldgen/source/places/**/primary-source/**/*.html",
      "!content/worldgen/source/places/**/pmtiles-map.json",
      "!content/worldgen/source/places/**/pmtiles-fit.json",
      "!content/worldgen/source/material-library/texture-audit.json",
      "!content/earth/structures/evidence/bridge-terrain/gugik/poniatowski_bridge.json",
      "!content/earth/structures/evidence/osm-features.json",
      "!content/earth/structures/evidence/wikidata-details.json",
      "!content/earth/structures/georeferencing.json",
      "!content/earth/structures/readiness.json",
      "!content/earth/structures/placements"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "content/**/*.json",
        "content/worldgen/source/places/**/models/*.mjs",
        "reference-lock.json"
      ],
      "files": {
        "maxSize": 16777216
      }
    },
    {
      "includes": [
        "packages/worldgen/scripts/**",
        "content/worldgen/source/places/**/models/*.mjs",
        "packages/entities/scripts/**",
        "content/entities/source/**/models/*.mjs",
        "assets/structures/*/scripts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useExponentiationOperator": "off"
          }
        }
      }
    },
    {
      "includes": [
        "content/worldgen/source/places/**/*.mjs",
        "packages/worldgen/scripts/generalife-model.mjs",
        "packages/worldgen/scripts/generate-island-bridge.mjs",
        "packages/worldgen/scripts/generate-ponte-coperto.mjs",
        "packages/worldgen/scripts/kyoto-station-model.mjs",
        "packages/worldgen/scripts/london-victoria-station-model.mjs",
        "packages/worldgen/scripts/structure-bach-house.mjs",
        "packages/worldgen/scripts/structure-chatsworth-house.mjs"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noFlatMapIdentity": "off",
            "noUselessContinue": "off",
            "useFlatMap": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "useConst": "off",
            "useExponentiationOperator": "off",
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/worldgen/scripts/generate-*.mjs",
        "packages/worldgen/scripts/caracalla-baths-model.mjs",
        "packages/worldgen/scripts/fort-temiscamingue-outbuildings.mjs",
        "packages/worldgen/scripts/oviedo-cathedral-model.mjs",
        "packages/worldgen/scripts/shirvanshah-palace-model.mjs",
        "packages/worldgen/scripts/structure-statue-of-the-empress-josephine.mjs",
        "packages/worldgen/scripts/zwinger-model.mjs",
        "packages/tooling/scripts/source-runtime-lods.mjs"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noFlatMapIdentity": "off"
          },
          "style": {
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/worldgen/scripts/structure-collections.mjs"],
      "linter": {
        "rules": {
          "complexity": {
            "useOptionalChain": "off"
          }
        }
      }
    },
    {
      "includes": [
        "content/worldgen/source/places/r1/r1f/adelaide_gaol/models/adelaide-gaol-model.mjs",
        "content/worldgen/source/places/tt/tts/lahore_fort/models/lahore-fort-model.mjs"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noAccumulatingSpread": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/worldgen/scripts/generalife-model.mjs",
        "content/worldgen/source/places/w4/w4r/yah_leh_monument/models/yah-leh-monument-model.mjs",
        "content/worldgen/source/places/ws/wsq/taipei_main_station/models/station-model.mjs"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noApproximativeNumericConstant": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "content/**/assets/**/*.json",
        "content/**/source/**/*.json",
        "content/entities/types/**/*.json",
        "content/entities/scenes/**/*.json",
        "content/worldgen/styles/**/*.json",
        "content/worldgen/landmarks/**/*.json",
        "content/worldgen/scatter/**/*.json",
        "content/worldgen/fixtures/**/*.json",
        "content/worldgen/interiors/**/*.json",
        "content/worldgen/structures/**/*.json",
        "content/earth/businesses/catalog.json",
        "content/earth/airports/**/*.json",
        "content/earth/structures/evidence/bridge-terrain/**/*.json",
        "content/earth/world.atlas.json",
        "content/earth/signs/regions.atlas.json",
        "content/earth/signs/us-states.json",
        "content/earth/signs/route-shields.json",
        "content/ecology/ecoregions.json",
        "content/**/regional.catalog.json",
        "content/wildlife/ranges.json",
        "examples/**/captures/**/*.json",
        "examples/**/public/terrain/**/SOURCES.json"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
