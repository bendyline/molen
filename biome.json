{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-types",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.artifacts",
      "!review-lock.json",
      "!content/earth/fonts/*.json",
      "!**/__output__",
      "!**/.tmp",
      "!spikes",
      "!docs-site/.vitepress/cache",
      "!examples/*/public/packs",
      "!content/entities/gen",
      "!content/entities/types/generated-scripts",
      "!content/earth/source/signs/americana/*.svg",
      "!content/worldgen/source/places/**/reference-rights/**/*.html",
      "!content/worldgen/source/places/**/references/**/*.html",
      "!content/worldgen/source/places/**/map-sources/**/*.html",
      "!content/worldgen/source/material-library/texture-audit.json",
      "!content/earth/structures/evidence/bridge-terrain/gugik/poniatowski_bridge.json",
      "!content/earth/structures/evidence/osm-features.json",
      "!content/earth/structures/evidence/wikidata-details.json",
      "!content/earth/structures/georeferencing.json",
      "!content/earth/structures/readiness.json",
      "!content/earth/structures/placements"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "content/earth/world.atlas.json",
        "content/ecology/regional.catalog.json",
        "content/worldgen/source/places/9q/9q5/ambassador_hotel_los_angeles/terrain-grid.json"
      ],
      "files": {
        "maxSize": 4194304
      }
    },
    {
      "includes": [
        "packages/worldgen/scripts/**",
        "content/worldgen/source/places/**/models/*.mjs",
        "packages/entities/scripts/**",
        "content/entities/source/**/models/*.mjs",
        "assets/structures/*/scripts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useExponentiationOperator": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "content/**/assets/**/*.json",
        "content/**/source/**/*.json",
        "content/entities/types/**/*.json",
        "content/entities/scenes/**/*.json",
        "content/worldgen/styles/**/*.json",
        "content/worldgen/landmarks/**/*.json",
        "content/worldgen/scatter/**/*.json",
        "content/worldgen/fixtures/**/*.json",
        "content/worldgen/interiors/**/*.json",
        "content/worldgen/structures/**/*.json",
        "content/earth/businesses/catalog.json",
        "content/earth/airports/**/*.json",
        "content/earth/structures/evidence/bridge-terrain/**/*.json",
        "content/earth/world.atlas.json",
        "content/earth/signs/regions.atlas.json",
        "content/earth/signs/us-states.json",
        "content/earth/signs/route-shields.json",
        "content/ecology/ecoregions.json",
        "content/**/regional.catalog.json",
        "content/wildlife/ranges.json",
        "examples/**/captures/**/*.json",
        "examples/**/public/terrain/**/SOURCES.json"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
