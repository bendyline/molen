{
  "name": "@bendyline/molen-docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The molen.dev documentation site: guides, generated API reference, schemas, and samples",
  "scripts": {
    "gen": "node scripts/generate-all.mjs",
    "gen:check": "node scripts/generate-all.mjs --check",
    "dev": "node scripts/generate-all.mjs && vitepress dev",
    "build": "node scripts/generate-all.mjs && vitepress build && node scripts/stage-hosted.mjs",
    "stage": "node scripts/stage-hosted.mjs",
    "preview": "vitepress preview",
    "lint": "biome check scripts"
  },
  "devDependencies": {
    "@bendyline/molen-examples-city-courier": "workspace:*",
    "@bendyline/molen-examples-cubes": "workspace:*",
    "@bendyline/molen-examples-data-viz": "workspace:*",
    "@bendyline/molen-examples-figures-gallery": "workspace:*",
    "@bendyline/molen-examples-home": "workspace:*",
    "@bendyline/molen-examples-lantern-dungeon": "workspace:*",
    "@bendyline/molen-examples-skybound": "workspace:*",
    "@bendyline/molen-examples-terrain-flyover": "workspace:*",
    "@bendyline/molen-examples-top-down-arena": "workspace:*",
    "@bendyline/molen-examples-world-explorer": "workspace:*",
    "@bendyline/molen-pack": "workspace:*",
    "@bendyline/molen-tooling": "workspace:*",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "catalog:",
    "vitepress": "^1.6.4"
  }
}
