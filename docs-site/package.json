    "preview": "vitepress preview",
    "lint": "biome check scripts"
  },
  "devDependencies": {
    "@bendyline/molen-tooling": "workspace:*",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
