{
  "name": "@bendyline/molen-docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The molen.dev documentation site: guides, generated API reference, schemas, and samples",
  "scripts": {
    "gen": "node scripts/generate-all.mjs",
    "gen:check": "node scripts/generate-all.mjs --check",
