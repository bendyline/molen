# Keep source, generated metadata and review reports identical across checkouts.
* text=auto eol=lf

# Model and image hashes always describe exact binary bytes.
*.glb -text
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text

# Source rasters hash their downloaded bytes, including CRLF line endings.
*.xyz -text
*.tif -text
*.tiff -text

# Archive rights records are checked against the exact downloaded bytes.
content/worldgen/source/**/reference-rights/**/*.html binary
content/worldgen/source/**/reference-rights/**/*.xml binary
