{
  "name": "molen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "node scripts/clean.mjs",
    "clean:dist": "node scripts/clean.mjs --dist",
    "reinstall": "node scripts/clean.mjs && pnpm install && pnpm -r build && pnpm install",
    "pretypecheck": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "source:check": "node scripts/check-source-bundles.mjs",
    "audit:prod": "pnpm audit --prod",
    "lint": "pnpm -r lint && biome check . && node scripts/check-release-gate.mjs && node scripts/check-package-contents.mjs && node scripts/check-shipped-docs.mjs",
    "pretest:unit": "pnpm -r build",
    "test:unit": "pnpm -r --no-bail test:unit",
    "test": "pnpm test:unit",
    "pretest:golden": "pnpm -r build",
    "test:golden": "pnpm -r --workspace-concurrency=1 --no-bail test:golden",
    "verify": "pnpm lint && pnpm typecheck && pnpm source:check && pnpm docs:check && pnpm test:unit && pnpm audit:prod",
    "all": "pnpm install && pnpm build && pnpm verify && pnpm smoke:packed && pnpm docs:site:check && pnpm docs:site:build && pnpm exec playwright install chromium && pnpm test:golden",
    "stamp:docs": "node scripts/stamp-docs-version.mjs",
    "docs:gen": "node packages/tooling/scripts/generate-schema-docs.mjs",
    "docs:check": "node packages/tooling/scripts/generate-schema-docs.mjs --check",
    "docs:site:gen": "pnpm --filter @bendyline/molen-docs-site gen",
    "docs:site:check": "pnpm --filter @bendyline/molen-docs-site gen:check",
    "docs:site:dev": "pnpm --filter @bendyline/molen-docs-site dev",
    "docs:site:build": "pnpm --filter @bendyline/molen-docs-site build",
    "docs:site:preview": "pnpm --filter @bendyline/molen-docs-site preview",
    "release": "semantic-release",
    "release:bootstrap": "node scripts/bootstrap-release.mjs",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "predev": "pnpm --filter \"./packages/**\" -r build && node examples/world-explorer/scripts/build-content-packs.mjs",
    "dev": "pnpm --filter @bendyline/molen-examples-home dev",
    "dev:driving": "pnpm --filter @bendyline/molen-examples-city-courier dev",
    "dev:dungeon": "pnpm --filter @bendyline/molen-examples-lantern-dungeon dev",
    "dev:platformer": "pnpm --filter @bendyline/molen-examples-skybound dev",
    "dev:packages": "pnpm --filter \"./packages/**\" -r build && pnpm --filter \"./packages/**\" -r --parallel exec tsdown --watch",
    "predocs:site:gen": "pnpm -r build",
    "predocs:site:check": "pnpm -r build",
    "predocs:site:build": "pnpm -r build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.0",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "playwright": "^1.63.0",
    "semantic-release": "25.0.8"
  },
  "license": "MIT"
}
