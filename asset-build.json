{
  "format": "molen/asset-build@2",
  "node": "24",
  "repository": "bendyline/molen",
  "inputs": {
    "version": 1,
    "data": [
      "assets/structures",
      "content/entities/source",
      "content/worldgen/source",
      "content/worldgen/materials",
      "content/earth/structures/georeferencing.json",
      "examples/lantern-dungeon/asset-src",
      "examples/world-explorer/STRUCTURE-EXPANSION-PLAN.md"
    ],
    "exclude": [
      "shots/",
      "medium-fi/",
      "preview.png",
      "*.md",
      "*.html",
      "asset.json",
      "project.json",
      "qa.json",
      "capture-report.json",
      "shared-capture-report.json",
      "placement-report.json",
      "import-report.json",
      "texture-audit.json",
      "material-texture-audit.json"
    ]
  },
  "generators": [
    {
      "id": "worldgen-stadiums",
      "command": ["node", "packages/worldgen/scripts/generate-stadium-models.mjs"]
    },
    {
      "id": "worldgen-signature-towers",
      "command": ["node", "packages/worldgen/scripts/generate-signature-towers.mjs"]
    },
    {
      "id": "worldgen-additional-landmarks",
      "command": ["node", "packages/worldgen/scripts/generate-additional-landmarks.mjs"]
    },
    {
      "id": "worldgen-place-u35-ksiaz-entrances",
      "command": [
        "node",
        "content/worldgen/source/places/u3/u35/ksiaz-entrances/models/generate-ksiaz-entrances.mjs"
      ]
    },
    {
      "id": "worldgen-place-u35-ksiaz-park-structures",
      "command": [
        "node",
        "content/worldgen/source/places/u3/u35/ksiaz-park-structures/models/generate-ksiaz-park-structures.mjs"
      ]
    },
    {
      "id": "worldgen-place-u35-ksiaz-service-structures",
      "command": [
        "node",
        "content/worldgen/source/places/u3/u35/ksiaz_forester_house/models/generate-ksiaz-service-structures.mjs"
      ]
    },
    {
      "id": "worldgen-place-u35-ksiaz-swiss-houses",
      "command": [
        "node",
        "content/worldgen/source/places/u3/u35/ksiaz-swiss-houses/models/generate-ksiaz-swiss-houses.mjs"
      ]
    },
    {
      "id": "worldgen-place-u35-old-ksiaz",
      "command": [
        "node",
        "content/worldgen/source/places/u3/u35/old_ksiaz_ruins/models/generate-old-ksiaz.mjs"
      ]
    },
    {
      "id": "worldgen-place-u35-ksiaz-park-gates",
      "command": [
        "node",
        "content/worldgen/source/places/u3/u35/ksiaz-park-gates/models/generate-ksiaz-park-gates.mjs"
      ]
    },
    {
      "id": "worldgen-researched-bridges",
      "command": ["node", "packages/worldgen/scripts/generate-researched-bridges.mjs"]
    },
    {
      "id": "worldgen-heritage-towers",
      "command": ["node", "packages/worldgen/scripts/generate-heritage-towers.mjs"]
    },
    {
      "id": "worldgen-structure-catalog",
      "command": ["node", "packages/worldgen/scripts/generate-structure-catalog.mjs"]
    },
    {
      "id": "worldgen-lighthouses",
      "command": ["node", "packages/worldgen/scripts/generate-lighthouse-models.mjs"]
    },
    {
      "id": "worldgen-place-dp3-willis-tower",
      "command": [
        "node",
        "content/worldgen/source/places/dp/dp3/willis_tower/models/generate-willis-tower.mjs"
      ]
    },
    {
      "id": "worldgen-landmarks",
      "command": ["node", "packages/worldgen/scripts/generate-landmark-models.mjs"]
    },
    {
      "id": "worldgen-place-sxk-galata-tower",
      "command": [
        "node",
        "content/worldgen/source/places/sx/sxk/galata_tower/models/generate-galata-tower.mjs"
      ]
    },
    {
      "id": "worldgen-place-u7q-gamla-bron",
      "command": [
        "node",
        "content/worldgen/source/places/u7/u7q/gamla_bron/models/generate-gamla-bron.mjs"
      ]
    },
    {
      "id": "worldgen-place-gcn-severn-bridge",
      "command": [
        "node",
        "content/worldgen/source/places/gc/gcn/severn_bridge/models/generate-severn-bridge.mjs"
      ]
    },
    {
      "id": "worldgen-site-structures",
      "command": ["node", "packages/worldgen/scripts/generate-site-structures.mjs"]
    },
    {
      "id": "worldgen-map-structures",
      "command": ["node", "packages/worldgen/scripts/generate-map-structures.mjs"]
    },
    {
      "id": "worldgen-props",
      "command": ["node", "packages/worldgen/scripts/generate-pack.mjs"]
    },
    {
      "id": "entities-aircraft-oh6",
      "command": ["node", "content/entities/source/aircraft/oh-6/models/generate.mjs"]
    },
    {
      "id": "entities-aircraft-p51",
      "command": ["node", "content/entities/source/aircraft/p-51/models/generate.mjs"]
    },
    {
      "id": "entities-aircraft-airliner",
      "command": ["node", "content/entities/source/aircraft/airliner/models/generate.mjs"]
    },
    {
      "id": "entities-aircraft-expansion",
      "command": ["node", "packages/entities/scripts/generate-aircraft.mjs"]
    },
    {
      "id": "entities-transit-bus",
      "command": ["node", "content/entities/source/transit/bus/models/generate.mjs"]
    },
    {
      "id": "entities-transit-lightrail",
      "command": ["node", "content/entities/source/transit/light-rail-car/models/generate.mjs"]
    },
    {
      "id": "entities-fleet",
      "command": ["node", "packages/entities/scripts/generate-fleet.mjs"]
    },
    {
      "id": "entities-json-models",
      "command": ["node", "packages/entities/scripts/generate-json-models.mjs"]
    },
    {
      "id": "red-barn",
      "command": ["node", "assets/structures/red-barn/scripts/generate-barn.mjs"]
    },
    {
      "id": "lantern-dungeon",
      "outputs": ["examples/lantern-dungeon/asset-src"],
      "command": ["python", "examples/lantern-dungeon/tools/generate-assets.py"]
    },
    {
      "id": "worldgen-place-u35-ksiaz-stables",
      "command": [
        "node",
        "content/worldgen/source/places/u3/u35/ksiaz_stable_ensemble/models/generate-ksiaz-stables.mjs"
      ]
    },
    {
      "id": "worldgen-place-u35-ksiaz-palm-house",
      "command": [
        "node",
        "content/worldgen/source/places/u3/u35/ksiaz_palm_house/models/generate-ksiaz-palm-house.mjs"
      ]
    },
    {
      "id": "worldgen-place-u35-ksiaz-palm-services",
      "command": [
        "node",
        "content/worldgen/source/places/u3/u35/ksiaz-palm-services/models/generate-ksiaz-palm-services.mjs"
      ]
    },
    {
      "id": "worldgen-authored-places",
      "command": ["node", "packages/worldgen/scripts/generate-authored-places.mjs"]
    }
  ],
  "afterImport": [
    {
      "id": "worldgen-runtime-lods",
      "command": ["node", "packages/tooling/scripts/generate-landmark-lods.mjs"]
    },
    {
      "id": "lantern-dungeon-import-report",
      "command": ["node", "examples/lantern-dungeon/tools/import-assets.mjs"]
    }
  ],
  "masters": [
    "content/entities/source/vehicles/compact/models/source.glb",
    "content/entities/source/vehicles/pickup/models/source.glb",
    "content/entities/source/vehicles/sedan/models/source.glb",
    "content/entities/source/vehicles/suv/models/source.glb",
    "content/entities/source/vehicles/van/models/source.glb"
  ]
}
