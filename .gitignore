!content/worldgen/source/places/**/shots/terrain-closeup/
!content/worldgen/source/places/**/shots/terrain-closeup/review.json
# Bulk review captures stay local; builds and CI do not need a screenshot archive.
# Keep reports, source textures/heightmaps and small preview.png thumbnails in Git.
**/medium-fi/**/*.png
**/medium-fi/**/*.jpg
**/medium-fi/**/*.jpeg
**/medium-fi/**/*.webp
test-results/
.turbo/
.artifacts/
# Per-model round notes are transient; retain model QA and batch completion reports.
/content/worldgen/source/structure-catalog/rounds/*-n[0-9][0-9][0-9][0-9].md
.pnpm-store/
debug.log
.DS_Store
# GLBs are build outputs of checked-in generators (pnpm assets:build), published as bundles
# named by their inputs (pnpm assets:fetch). See content/ASSET-PACKS.md.
*.glb
# Authored masters with no generator are source; asset-build.json lists them as "masters".
!content/entities/source/vehicles/compact/models/source.glb
!content/entities/source/vehicles/pickup/models/source.glb
!content/entities/source/vehicles/sedan/models/source.glb
!content/entities/source/vehicles/suv/models/source.glb
!content/entities/source/vehicles/van/models/source.glb
examples/*/public/packs/

# docs-site: pages generated from packages/, docs-src/ and examples/ (pnpm docs:site:gen).
# .vitepress/generated-nav.json IS committed — `pnpm docs:site:check` verifies it in CI.
docs-site/api/
docs-site/guide/
docs-site/schemas/
docs-site/samples/
docs-site/reference/
docs-site/public/
docs-site/.vitepress/cache/
/archive

# Compiled placement regions and local authoring preview; sources live in earth/source/placements.
/content/earth/structures/placements/
