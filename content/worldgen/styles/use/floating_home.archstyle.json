{
  "format": "molen/archstyle@1",
  "id": "molen.worldgen.use.floating_home",
  "title": "Floating home",
  "doc": "A houseboat moored in a row along a dock, as on Lake Union, in Portland or Sausalito: one or two storeys of painted lap, shingle or board-and-batten siding in harbor blues, teals, yellows, reds, greys and whites, low shed, gable or flat roofs with timber decks, large windows and open-railed upper decks. The building stands on a weathered timber or dark concrete float a little wider than its walls, its deck the foundation height above the water (the request's waterline).",
  "version": 1,
  "applicability": {
    "classes": ["floating_home", "houseboat", "house"]
  },
  "massing": {
    "floorHeight": { "min": 2.6, "max": 2.9 },
    "groundFloorHeight": { "min": 2.7, "max": 3 },
    "heightFallback": [
      { "when": { "areaMax": 60 }, "levels": { "min": 1, "max": 1 } },
      { "when": { "areaMax": 140 }, "levels": { "min": 1, "max": 2 } },
      { "levels": { "min": 2, "max": 2 } }
    ],
    "groundFit": "platform-average",
    "foundation": { "height": { "min": 0.35, "max": 0.6 }, "exposeOnSlope": false },
    "wings": {
      "split": "rectangles",
      "maxWingSpan": 12,
      "minWingArea": 14,
      "secondaryHeightScale": { "min": 0.55, "max": 0.9 }
    },
    "setbacks": [],
    "respectMinHeight": true
  },
  "roof": {
    "perWing": true,
    "ridge": "long-axis",
    "overhang": { "min": 0.3, "max": 0.6 },
    "complexFootprint": "wings",
    "choices": [
      {
        "type": "shed",
        "weight": 4,
        "pitchDeg": { "min": 7, "max": 15 },
        "shedDirection": "random"
      },
      {
        "type": "gable",
        "weight": 4,
        "pitchDeg": { "min": 18, "max": 30 },
        "when": { "elongationMin": 1.1 }
      },
      {
        "type": "hip",
        "weight": 1,
        "pitchDeg": { "min": 18, "max": 26 }
      },
      {
        "type": "flat",
        "weight": 3,
        "parapet": { "height": { "min": 0.25, "max": 0.4 }, "thickness": 0.12 }
      }
    ],
    "fallback": "flat"
  },
  "facade": {
    "bays": { "width": { "min": 2.2, "max": 3 }, "cornerMargin": 0.45 },
    "windows": {
      "style": "punched",
      "width": { "min": 1.3, "max": 1.9 },
      "height": { "min": 1.4, "max": 1.8 },
      "sill": { "min": 0.55, "max": 0.8 },
      "probabilityPerBay": 0.9,
      "groundFloor": "same"
    },
    "bands": {
      "base": { "height": { "min": 0.12, "max": 0.2 } },
      "floorLines": false,
      "cornice": { "height": 0.14 }
    },
    "details": {
      "entrance": { "width": 1, "height": 2.1, "style": "single" },
      "cornerBoards": true,
      "balconies": { "depth": 1.05, "railing": "open", "every": 2 }
    }
  },
  "materials": {
    "wall": {
      "choices": [
        { "ref": "matgraph:molen.worldgen.material.wood_painted_lap", "weight": 4 },
        { "ref": "matgraph:molen.worldgen.material.wood_painted_shingle", "weight": 2 },
        { "ref": "matgraph:molen.worldgen.material.wood_board_batten", "weight": 2 },
        {
          "ref": "matgraph:molen.worldgen.material.shingle_cedar",
          "weight": 1,
          "palette": "cedar"
        }
      ],
      "palette": "siding",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [3, 2.4],
      "uvOffset": "meters",
      "uvMirror": true
    },
    "roof": {
      "choices": [
        { "ref": "matgraph:molen.worldgen.material.metal_standing_seam", "weight": 3 },
        { "ref": "matgraph:molen.worldgen.material.shingle_asphalt", "weight": 2 }
      ],
      "palette": "roof",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [2, 2],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "flatRoof": {
      "choices": [
        { "ref": "matgraph:molen.worldgen.material.wood_plain", "weight": 2, "palette": "deck" },
        { "ref": "matgraph:molen.worldgen.material.membrane", "weight": 1 }
      ],
      "palette": "flatRoof",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [3, 3],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "trim": {
      "choices": [{ "ref": "palette:#ffffff", "weight": 1 }],
      "palette": "trim",
      "tint": "multiply",
      "uv": "meters",
      "uvOffset": "none",
      "uvMirror": false
    },
    "foundation": {
      "choices": [
        { "ref": "matgraph:molen.worldgen.material.wood_plain", "weight": 2, "palette": "float" },
        { "ref": "matgraph:molen.worldgen.material.concrete_plain", "weight": 1 }
      ],
      "palette": "foundation",
      "tint": "multiply",
      "uv": "meters",
      "uvScale": [2.5, 2.5],
      "uvOffset": "meters",
      "uvMirror": false
    },
    "window": {
      "choices": [{ "ref": "matgraph:molen.worldgen.material.window_punched", "weight": 1 }],
      "tint": "none",
      "uv": "cell",
      "uvOffset": "none",
      "uvMirror": false
    }
  },
