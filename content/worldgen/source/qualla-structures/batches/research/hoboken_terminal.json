  "sources": [
    {
      "url": "https://npgallery.nps.gov/NRHP/GetAsset/05a8d18f-5c83-4ae4-88f7-88d783b042ea",
      "pages": "1,9–15,54,57–58",
      "inspection": "Primary1973/2004 nomination relevant descriptions and rendered plans54/57/58 inspected. Six elliptical river openings, five gabled plaza pavilions, canopy and own rail waiting-room/low south rooms are distinct from western Train Shed, Baggage/YMCA and Pullman buildings. River frontage566ft2.125in(~172.57m) includes south restaurant; main waiting room100x90ft. Site plans show rear concourse/river-side pier rooms with open slips, not a solid full-depth block. Original225ft tower preceded current replica; current project manager225ft used for reconstruction."
    },
    {
      "url": "https://www.njtransit.com/press-releases/history-comes-light-city-hoboken",
      "inspection": "Operator2008 restored tower dedication record read: new replica of original, four12ft clock faces, four-foot copper Lackawanna letters and hip/cupola roof. Old tower height cited230ft conflicts operator2006 historical203ft; do not silently treat either as surveyed restored height."
    },
    {
      "url": "https://www.njtransit.com/press-releases/nj-transit-begin-rebuilding-clock-tower-hoboken-terminal",
      "inspection": "Operator2006 radio-tower removal/reconstruction record read; historical tower203ft conflicts2008 statement230ft. Restoration era is relevant; pre2007 originals cannot establish reconstructed tower."
    },
    {
      "url": "https://stvinc.com/project/hoboken-ferry-terminal-and-yard-resilience/",
      "inspection": "Actual reconstruction project manager/designer record read: restored tower225ft(68.58m), distinct from entire54-acre yard. Prefer project-as-built dimensional control provisionally, reconcile actual measured footprint/photographic proportions."
    },
    {
      "url": "https://www.njtransit.com/press-releases/nj-transit-begins-process-find-marquee-tenant-newly-renovated-historic-hoboken-ferry",
      "inspection": "Operator2025 record read: first/second floor ferry building undergoing restoration. Model era will follow selected2010/2015 originals; current construction is not assumed finished from future-use prose."
    },
    {
      "url": "https://www.google.com/maps/@40.7347,-74.0274,18z/data=!3m1!1e3",
      "inspection": "Aerial inspected: long angled ferry block with dark flat roof and repeated rectangular skylights, narrow own green-roofed rail waiting-room at junction, and large western train-shed/platform complex. Plain north ferry wall and waterfront finger piers belong to era-specific scope; surrounding boats/docks/large platform roofs must not be accidentally included."
    }
  ],
