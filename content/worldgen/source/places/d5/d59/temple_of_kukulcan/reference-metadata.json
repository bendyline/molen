  "currentRoundInspection": {
    "inspectedOn": "2026-10-18",
    "scope": "Specific Temple of Kukulcan exterior: nine mapped sloping stages, four straight mapped stair flights, north serpent-terminal sculptures, summit shrine walls/openings, flat roof and cornice bands. Retain the approximately56m body and wider stair projections separately. Shallow recessed wall panels and serpent profiles are picture-guided medium-fi geometry; hidden earlier pyramids and internal artifacts are omitted.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Chichen_Itza_3.jpg",
        "viewedAt": "https://en.wikipedia.org/wiki/El_Castillo,_Chichen_Itza#/media/File:Chichen_Itza_3.jpg",
        "author": "Daniel Schwen",
        "license": "CC BY-SA 4.0; viewed only.",
        "date": "2009-08-18",
        "observations": "North-west overview: nine sloping limestone stages with narrow ledges and inset rectangular panels, four straight stairways with broad sloping balustrades, a small flat-roof summit shrine with substantial horizontal frieze/cornice bands. Rough pale grey/warm limestone and restrained contrast. Ordinary article gives24m body plus6m temple and55.3m base; wider map bounds include stair projections."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Chichen_Norte.JPG",
        "viewedAt": "https://en.wikipedia.org/wiki/El_Castillo,_Chichen_Itza#/media/File:Chichen_Norte.JPG",
        "author": "Lfyenrcnhan",
        "license": "Public Domain; viewed only.",
        "date": "2007-07-10",
        "observations": "North stair has two serpent heads at its feet and broad straight sloping rails. Summit north entrance has three dark openings separated by two round columns. Nine tier faces have shallow panel rhythms beneath their ledges. Exact stair counts, stone blocks and erosion are not surveyed."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Serpent_head_at_the_base_of_El_Castillo.jpg",
        "viewedAt": "https://en.wikipedia.org/wiki/El_Castillo,_Chichen_Itza#/media/File:Serpent_head_at_the_base_of_El_Castillo.jpg",
        "author": "Frank Kovalchek",
        "license": "CC BY 2.0; viewed only.",
        "date": "2009-03-28",
        "observations": "Serpent terminals are squat limestone sculptures with projecting snout, raised crown/eye region, open mouth and long low lower jaw. Carved scales and volutes are fine surface details rather than extra materials; preserve the open silhouette and a simplified eye rim near the camera. No exact sculptural copying."
      }
    ]
  }
