    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Shrine_of_Imam_Ali_Najaf_August_2023.jpg",
        "author": "Goudarz.memar",
        "date": "2023-08-22",
        "license": "CC-BY-SA-4.0",
        "observed": "Rooftop view of bulbous golden dome with blue drum band, twin cylindrical gilded minarets with projecting galleries and lobed caps, tiled square clock tower with open gold upper pavilion. Court canopies and restoration scaffolding are temporary features; gilded iwan restoration is noted in the caption."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Meshed_ali_usnavy_(PD).jpg",
        "author": "Arlo K. Abrahamson / U.S. Navy",
        "date": "2003-04-08",
        "license": "Public domain in the United States",
        "observed": "Frontal historic gilded shrine facade: deep pointed iwan with closed rear entrance, flat projecting cornice, cylindrical twin minarets with corbelled balconies, upper gold shafts and ribbed caps; blue tiled returns and neighboring court arcades."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Imam_Ali_Mosque_in_Najaf.JPG",
        "author": "Hamed Malekpour / Tasnim News Agency",
        "date": "2014",
        "license": "CC-BY-4.0",
        "observed": "Oblique front corner shows depth of gilded pointed iwan and projecting roof, tiled side facade with pointed fields and upper band, minaret shafts/gallery/caps. Colored lamps are not modeled as permanent surface color."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Imam_Ali_Mosque_in_Najaf_(2).JPG",
        "author": "Mohammad Ali Marizad / Tasnim News Agency",
        "date": "2014",
        "license": "CC-BY-4.0",
        "observed": "Night front composition confirms pointed recessed iwan below projecting canopy and dome between the twin minarets. Festive strings, flags, lamps and temporary equipment are excluded from the permanent exterior approximation."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Ali%27s_shrine_in_the_morning.jpg",
        "author": "AHK AV",
        "date": "2025-08-10",
        "license": "CC0-1.0",
        "observed": "Low oblique court view confirms pointed tiled shrine-side fields and upper inscription band, gold dome/minaret and folded shade umbrellas. Generic shared mosaic abstracts the tile fields; calligraphy is not copied. Shade operating state varies; model uses an open-roof approximation."
      }
    ]
