    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Jerusalem-Al-Quds-2013(2)-Aerial-Qibli_Mosque-_(cropped).jpg",
        "author": "Andrew Shiva /Wikipedia /Godot13",
        "date": "2013-11-15",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected enlarged southern aerial of the prayer hall: broad ribbed silver-grey dome and finial near the south end,low round drum,raised long lead-grey central roof and sloping side roofs. Warm limestone south wall has buttresses,pointed windows and round upper openings above the older retaining wall. Northern forecourt is behind the roof. Adjacent city walls/excavations,trees,people and separate Dome of the Rock remain host content."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Jerusalem-2013-Temple_Mount-Al-Aqsa_Mosque_(NE_exposure).jpg",
        "author": "Andrew Shiva /Wikipedia /Godot13",
        "date": "2013-11-14",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected enlarged northeast exterior: seven pointed front porch arches with taller decorated central portal,green doors under the covered porch,small upper relief/window fields and sparse crenellated parapet. Raised central nave facade has paired pointed lights;the long east wall has buttresses,large pointed recess/window fields and upper lancets. Grey lead roofs and silver dome sit behind. The nearby small domed pavilion,forecourt fixtures and town are separate."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Jerusalem-2013(2)-Temple_Mount-Al-Aqsa_Mosque,_portal_(north_exposure).jpg",
        "author": "Andrew Shiva /Wikipedia /Godot13",
        "date": "2013-11-14",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected enlarged portal interior detail: green double panel door with studs below a pointed stone/lattice fanlight and pale limestone surround. Door panels and fanlight rhythm guide simplified shared-material fields. Fine lattice,carving,lettering,fixtures,carpets and the interior hanging lamp are not reproduced."
      }
    ]
