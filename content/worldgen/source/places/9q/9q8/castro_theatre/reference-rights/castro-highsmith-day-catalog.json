shington-dc-awardee-8"], "hassegments": true, "id": "http://www.loc.gov/item/sn84025815/1928-04-14/ed-1/", "image_url": ["https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_ontario_ver01:data:sn84025815:00220720470:1928041401:0001/full/pct:6.25/0/default.jpg#h=463&w=308", "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_ontario_ver01:data:sn84025815:00220720470:1928041401:0001/full/pct:12.5/0/default.jpg#h=927&w=617"], "index": 6, "language": ["english"], "location": ["san francisco", "alameda", "united states", "alameda county", "california", "oakland"], "mime_type": ["image/jp2", "application/pdf", "text/xml", "image/jpeg"], "number": ["sn84025815", "1", "00220720470"], "numeric_shelf_id": 192804141, "online_format": ["image", "pdf", "online text"], "original_format": ["newspaper"], "partof": ["serial and government publications division", "chronicling america", "the western outlook (san francisco, cal.) 1894-1928"], "publication_frequency": ["weekly"], "score": 23.548098, "shelf_id": "sn84025815, 1928-04-14, Edition 1", "site": ["chroniclingamerica"], "subject": ["san francisco", "san francisco (calif.)", "alameda county", "oakland (calif.)", "united states", "oakland", "alameda", "california", "alameda county (calif.)", "african american newspapers", "african americans", "newspapers", "african american"], "timestamp": "2023-08-08T14:46:12.687Z", "title": "The Western outlook (San Francisco, Cal.), April 14, 1928", "type": ["issue"], "url": "https://www.loc.gov/item/sn84025815/1928-04-14/ed-1/"}], "reproductions": "<p>\nSome images in this collection are described in groups; others are \ndescribed individually. In some cases, all of the images in the \ngroup display online, in other cases they do not.\n</p>\n\n<p>\nYou can download online images yourself.  Alternatively, you can \npurchase copies of various types.\n</p>\n\n<ol>\n<p>\t\n<strong><li>Determine whether the desired materials can be retrieved \nonline.</strong>\n</p>\n<ul>\n<p>\t\n<li>Look in the <strong>Medium</strong> field above to determine whether\n the description is for one photograph or more than one.</li>\n </p>\n <p>\n<li>If the description is for a single item and it is displaying, \nyou can download or purchase a print.  Cite the number that begins \nwith &quot;LC-DIG...&quot; when purchasing copies through Library of \nCongress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is \na &quot;Click for more images&quot; icon displaying, select that. \nIndividual images will display; you can download or purchase prints. \nCite the number that begins with &quot;LC-DIG...&quot; when purchasing \ncopies through Library of Congress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is no\n &quot;Click for more images&quot; icon displaying, return to the\n  &quot;About this Item&quot; tab and select the &quot;<i>Check for \n  online items from this group</i>&quot; link.  Then select the \n  \"Obtaining Copies\" tab for any retrieved items that are of interest.\n</p>\n</ul>\n</li>\n\n<p>\n<strong><li>If the images do not display online</strong> -- Select images for reproduction through one of these methods:\n</p>\n<ul>\n<p>\t\n<li>Visit the Prints &amp; Photographs Reading Room and request to view \nthe group (general information about service in the reading room is \navailable at: <a href=\"//www.loc.gov/rr/print/info/001_ref.html\">https://www.loc.gov/rr/print/info/001_ref.html</a>).</li>  \n</p>\n<p>\n<li>P&amp;P reading room staff can provide up to 15 photocopies of items \nper calendar year. (Color images cannot be photocopied.) For assistance,\n see our <a href=\"//www.loc.gov/rr/askalib/ask-print.html\">Ask a Librarian</a> page. OR</li>\n</p>\n<p>\n<li>Hire a freelance researcher to do further selection for you \n(a list of researchers is available at: \n<a href=\"//www.loc.gov/rr/print/resource/013_pic.html\">https://www.loc.gov/rr/print/resource/013_pic.html</a>).\n</p>\n</ul>\n</li>\n</ol>\n\n<p>\n<strong>Purchasing Copies</strong>\n</p>\n\n<p>\nLibrary of Congress Duplication Services can make copies of various \ntypes from images in Prints & Photographs Division Collections.  \nPrice lists, contact information, and order forms are available on the \n<a href=\"//www.loc.gov/duplicationservices/\">Duplication Services Web site</a>.\n</p>\n\n<p>\nCarol M. Highsmith sells prints of her photographs at: <a href=\"http://photographsamerica.com/\">http://photographsamerica.com/</a> .\n</p>  \n\n\n\n\n        ", "resources": [{"caption": "original digital file", "files": [[{"height": 282, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:20900:20917/full/pct:6.25/0/default.jpg", "width": 381}, {"height": 564, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:20900:20917/full/pct:12.5/0/default.jpg", "width": 762}, {"height": 1129, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:20900:20917/full/pct:25/0/default.jpg", "width": 1525}, {"height": 4517, "info": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:20900:20917/info.json", "levels": 7, "mimetype": "image/jp2", "size": 5832576, "url": "https://tile.loc.gov/storage-services/service/pnp/highsm/20900/20917.jp2", "width": 6101}]], "image": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:20900:20917/full/pct:6.25/0/default.jpg", "url": "https://www.loc.gov/resource/highsm.20917/"}], "thesaurus_entry": null, "timestamp": 1792400926999, "unrestricted": true}