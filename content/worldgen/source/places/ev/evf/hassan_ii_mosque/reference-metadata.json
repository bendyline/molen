    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Hassan_II_Mosque_-_general_framing,_Casablanca,_Morocco.jpg",
        "author": "Tinuzzo",
        "date": "2026-02-10",
        "license": "CC-BY-4.0;reference viewed only,not redistributed",
        "observed": "Inspected960×730 court-facing overview:tall square tan-stone minaret with long shallow carved/diamond fields,triple small arch lights,green tiled cornice band and setback upper crown. Broad prayer hall has nested green hip roofs,clerestory arches and large horseshoe/pointed door fields. Low court gallery has substantial piers/engaged columns,green foot bands and Moorish arches. Top is hazy;raw map height bands supply nominal controls."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Minaret_tower_of_the_Hassan_II_Mosque,_Casablanca,_Morocco.jpg",
        "author": "Tinuzzo",
        "date": "2026-02-10",
        "license": "CC-BY-4.0;reference viewed only,not redistributed",
        "observed": "Inspected500×633 upper-main-shaft detail:deep framed long diamond/sebka-like stone field,stepped pointed crown around three little arched lights,large green/white tiled band and pointed small parapet teeth. Thin corner strips and long shallow recesses. Original coarse diagonal geometry and shared mosaic approximate the motif;actual carving/inscriptions/tile artwork omitted."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Corridor_at_the_Hassan_II_Mosque,_Casablanca,_Morocco.jpg",
        "author": "Tinuzzo",
        "date": "2026-02-10",
        "license": "CC-BY-4.0;reference viewed only,not redistributed",
        "observed": "Inspected500×667 open arcade:thick square stone piers with engaged round shafts and block capitals;pointed horseshoe heads,deep reveals,flat decorated soffit and repeating bays. Green patterned tile bases,light/dark geometric paving. Fine ceiling and zellij artwork are omitted;columns are not the slender white/gold form of Sheikh Zayed."
      },
      {
        "page": "https://en.wikipedia.org/wiki/File:Sunshine_on_mosque_Hassan_II_in_Casablanca,_Morocco_-_Flickr_-_Milamber's_portfolio.jpg",
        "author": "Milamber's portfolio",
        "date": "2006-10-22",
        "license": "CC-BY-2.0;reference viewed only,not redistributed",
        "observed": "Inspected960×638 distant sea-facing sunrise silhouette:low broad stepped/hipped prayer-hall roof against one dominant square minaret,setback upper square stage,small rounded cap and tall stacked-ball finial. Mosque sits over the low sea platform. Distant historical silhouette guides facing/proportions,not current finish or surveyed seawall/shoreline levels."
      }
    ]
