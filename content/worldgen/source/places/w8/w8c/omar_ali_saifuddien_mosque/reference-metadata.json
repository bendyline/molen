  "currentRoundInspection": {
    "inspectedOn": "2026-10-17",
    "scope": "Four actually inspected exterior/barge pictures and normal viewer PMTiles/DEM;no bespoke surveys or redistributed photographs.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Exterior_of_Sultan_Omar_Ali_Saifuddien_Mosque_-_Brunei.jpg",
        "date": "2016-01-29",
        "author": "bvi4092",
        "license": "CC-BY-2.0;photograph viewed only",
        "observed": "Inspected960×686 daylight exterior. Large gold onion dome over a tall pale slotted drum and stepped base;white rectilinear hall with pointed dark windows,open gold-capped corner chattris,flat balustraded wings,screened colonnade and tall square minaret. The water-facing flank and broad shoreline steps are visible;fine ornament is not copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Sultan_Omar_Ali_Saifuddin_Mosque-LR1_(18564371516).jpg",
        "date": "2014-04-27",
        "author": "Jorge Láscar",
        "license": "CC-BY-2.0;photograph viewed only",
        "observed": "Inspected960×641 close courtyard-side view. Three large pointed/scalloped portico openings on columns,deep timber doors,tall pointed windows,upper narrow arcade band,tapered square turret bases and open octagonal gold-capped kiosks. The high square minaret has long narrow shaft slots,a projecting crown and open belfry."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:The_golden_domed_Sultan_Omar_Ali_Saifuddin_Mosque_(18404293330).jpg",
        "date": "2014-04-27",
        "author": "Jorge Láscar",
        "license": "CC-BY-2.0;photograph viewed only",
        "observed": "Inspected960×640 dusk overall view. Gold onion dome and square minaret dominate a long white building. Separate lagoon barge has sharply upturned ends,steep side pavilion roofs and a taller tiered central pavilion connected to a curved footbridge. Green illumination is lighting,not a paint-color source."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Mahligai_barge,_Omar_Ali_Saifuddien_Mosque,_April_2025_02.jpg",
        "date": "2025-04-09",
        "author": "Calistemon",
        "license": "CC-BY-SA-4.0;photograph viewed only",
        "observed": "Inspected fully loaded960×720 daylight barge view. Long cream/gold hull with tall swept bow/stern ends;low open side pavilions with steep pale green gables and a taller open central pavilion under tiered upturned green/gold roofs. Blue-grey panel accents and cream railings;curving bridge joins near the centre. Fine scrollwork,heraldry and exact current finishes are simplified."
      }
    ]
  }
