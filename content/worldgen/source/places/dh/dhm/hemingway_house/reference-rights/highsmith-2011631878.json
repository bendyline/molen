/jp2"], "number": ["99447278", "2002-12-14t20:42:23", "2025-06-06t18:21:24.900000", "http://www.loc.gov/item/99447278"], "online_format": ["image"], "original_format": ["map"], "partof": ["geography and map division", "military battles and campaigns", "catalog", "civil war maps"], "score": 22.200735, "shelf_id": "G3934.K6 1864 .U5", "site": ["catalog"], "subject": ["key west", "united states", "maps", "florida", "nautical charts", "harbors"], "timestamp": "2026-04-29T16:34:07.272Z", "title": "Key West harbor and its approaches", "type": ["cartographic"], "url": "https://www.loc.gov/item/99447278/"}, {"access_restricted": false, "aka": ["http://lccn.loc.gov/99447344", "http://www.loc.gov/item/99447344/", "https://search.catalog.loc.gov/instances/1c58d46c-5936-50d9-8eb1-acae77b7ad08", "https://hdl.loc.gov/loc.gmd/g3922s.cw0209000", "http://www.loc.gov/resource/g3922s.cw0209000/"], "campaigns": [], "contributor": ["smith, jim (jim c.)"], "date": "1861", "dates": ["1861"], "description": ["[1] Savannah River from U.S. Coast Survey. Scale ca. 1:63,360. 18 x 26 cm. [2] [Pensacola Bay] Scale ca. 1:80,000. 18 x 23 cm. [3] Chart of Key West, Florida. Scale ca. 1:125,000. 22 x 20 cm. Each chart indicates fortifications, place names, \"line of 18 feet depth of water,\" and a few soundings. Description derived from published bibliography. Scale not given. Library of Congress. Civil War maps (2nd ed.), 209 Available also through the Library of Congress web site as raster image."], "digitized": true, "extract_timestamp": "2026-04-29T15:39:41.311Z", "group": ["gmd.mar", "catalog-split-12", "catalog", "general-maps", "main-catalog-split-12"], "hassegments": false, "id": "http://www.loc.gov/item/99447344/", "image_url": ["https://tile.loc.gov/storage-services/service/gmd/gmd392/g3922/g3922s/cw0209000.gif", "https://tile.loc.gov/storage-services/service/gmd/gmd392/g3922/g3922s/cw0209000.gif#h=150&w=181", "https://tile.loc.gov/image-services/iiif/service:gmd:gmd392:g3922:g3922s:cw0209000/full/pct:12.5/0/default.jpg#h=509&w=615", "https://tile.loc.gov/image-services/iiif/service:gmd:gmd392:g3922:g3922s:cw0209000/full/pct:25/0/default.jpg#h=1018&w=1230"], "index": 5, "language": ["english"], "location": ["key west", "united states", "georgia", "pensacola", "savannah", "florida"], "mime_type": ["image/gif", "image/tiff", "image/jpeg", "image/jp2"], "number": ["2026-01-14t14:49:38.300000", "99447344", "http://www.loc.gov/item/99447344"], "online_format": ["image"], "original_format": ["map"], "partof": ["geography and map division", "military battles and campaigns", "catalog", "civil war maps"], "score": 22.200735, "shelf_id": "G3922.S3 1861 .S6", "site": ["catalog"], "subject": ["key west (fla.)", "key west", "civil war", "united states", "maps", "georgia", "history", "pensacola (fla.)", "savannah", "pensacola", "savannah (ga.)", "florida"], "timestamp": "2026-04-29T16:34:20.753Z", "title": "Charts of Savannah River, Pensacola Bay, and Key West. Showing the positions of the several fortifications. From the United States Coast Survey", "type": ["cartographic"], "url": "https://www.loc.gov/item/99447344/"}, {"access_restricted": false, "aka": ["http://www.loc.gov/item/2019218578/"], "campaigns": [], "date": "1879", "dates": ["[1879 TO 9999]"], "description": ["Daily (except Saturday), <1958-1995> Began in 1879. \"Independent Democratic.\" N.W. Ayer & Son's direct. of newspapers & magazines, 1976. Description based on: Volume XLVII, No. 42 (February 18, 1926); title from masthead (Chroniclingamerica.loc.gov, viewed February 6, 2019). Latest issue consulted: Vol. LXX, No. 180 (July 30, 1949) (Chroniclingamerica.loc.gov, viewed February 6, 2019)."], "digitized": true, "extract_timestamp": "2026-05-19T21:37:05.616Z", "group": ["ndnp/newspapers", "united-states-newspaper-directory"], "hassegments": false, "id": "http://www.loc.gov/item/2019218578/", "image_url": [], "index": 6, "language": ["english"], "location": ["key west", "united states", "monroe", "monroe county", "florida"], "number": ["2641-6182", "online resource", "233145066", "2026-04-13t21:30:13", "2019218578"], "original_format": ["newspaper"], "partof": ["serial and government publications division", "the key west citizen (key west, florida) 1879-current [online resource]", "directory of u.s. newspapers in american libraries"], "publication_frequency": ["daily"], "score": 22.200735, "shelf_id": "ISSN RECORD", "site": ["usnd"], "subject": ["key west (fla.)", "key west", "united states", "monroe", "monroe county (fla.)", "newspapers", "monroe county", "florida"], "timestamp": "2026-05-26T20:57:55.117Z", "title": "The Key West citizen", "type": ["title"], "url": "https://www.loc.gov/item/2019218578/"}], "reproductions": "<p>\nSome images in this collection are described in groups; others are \ndescribed individually. In some cases, all of the images in the \ngroup display online, in other cases they do not.\n</p>\n\n<p>\nYou can download online images yourself.  Alternatively, you can \npurchase copies of various types.\n</p>\n\n<ol>\n<p>\t\n<strong><li>Determine whether the desired materials can be retrieved \nonline.</strong>\n</p>\n<ul>\n<p>\t\n<li>Look in the <strong>Medium</strong> field above to determine whether\n the description is for one photograph or more than one.</li>\n </p>\n <p>\n<li>If the description is for a single item and it is displaying, \nyou can download or purchase a print.  Cite the number that begins \nwith &quot;LC-DIG...&quot; when purchasing copies through Library of \nCongress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is \na &quot;Click for more images&quot; icon displaying, select that. \nIndividual images will display; you can download or purchase prints. \nCite the number that begins with &quot;LC-DIG...&quot; when purchasing \ncopies through Library of Congress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is no\n &quot;Click for more images&quot; icon displaying, return to the\n  &quot;About this Item&quot; tab and select the &quot;<i>Check for \n  online items from this group</i>&quot; link.  Then select the \n  \"Obtaining Copies\" tab for any retrieved items that are of interest.\n</p>\n</ul>\n</li>\n\n<p>\n<strong><li>If the images do not display online</strong> -- Select images for reproduction through one of these methods:\n</p>\n<ul>\n<p>\t\n<li>Visit the Prints &amp; Photographs Reading Room and request to view \nthe group (general information about service in the reading room is \navailable at: <a href=\"//www.loc.gov/rr/print/info/001_ref.html\">https://www.loc.gov/rr/print/info/001_ref.html</a>).</li>  \n</p>\n<p>\n<li>P&amp;P reading room staff can provide up to 15 photocopies of items \nper calendar year. (Color images cannot be photocopied.) For assistance,\n see our <a href=\"//www.loc.gov/rr/askalib/ask-print.html\">Ask a Librarian</a> page. OR</li>\n</p>\n<p>\n<li>Hire a freelance researcher to do further selection for you \n(a list of researchers is available at: \n<a href=\"//www.loc.gov/rr/print/resource/013_pic.html\">https://www.loc.gov/rr/print/resource/013_pic.html</a>).\n</p>\n</ul>\n</li>\n</ol>\n\n<p>\n<strong>Purchasing Copies</strong>\n</p>\n\n<p>\nLibrary of Congress Duplication Services can make copies of various \ntypes from images in Prints & Photographs Division Collections.  \nPrice lists, contact information, and order forms are available on the \n<a href=\"//www.loc.gov/duplicationservices/\">Duplication Services Web site</a>.\n</p>\n\n<p>\nCarol M. Highsmith sells prints of her photographs at: <a href=\"http://photographsamerica.com/\">http://photographsamerica.com/</a> .\n</p>  \n\n\n\n\n        ", "resources": [{"caption": "digital file from original", "files": [[{"height": 340, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:13600:13684/full/pct:6.25/0/default.jpg", "width": 430}, {"height": 680, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:13600:13684/full/pct:12.5/0/default.jpg", "width": 861}, {"height": 1360, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:13600:13684/full/pct:25/0/default.jpg", "width": 1722}, {"height": 5442, "info": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:13600:13684/info.json", "levels": 7, "mimetype": "image/jp2", "size": 5451687, "url": "https://tile.loc.gov/storage-services/service/pnp/highsm/13600/13684.jp2", "width": 6891}]], "image": "https://tile.loc.gov/storage-services/service/pnp/highsm/13600/13684t.gif", "url": "https://www.loc.gov/resource/highsm.13684/"}], "thesaurus_entry": null, "timestamp": 1792364301938, "unrestricted": true}