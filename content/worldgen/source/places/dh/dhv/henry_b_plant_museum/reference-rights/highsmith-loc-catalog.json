: ["catalog"], "subject": ["estuarine area conservation", "estuarine ecology", "tampa bay (fla.)", "tampa bay", "estuaries", "florida"], "timestamp": "2023-07-10T11:30:05.933Z", "title": "Integrating science and resource management in Tampa Bay, Florida", "type": ["text"], "url": "//lccn.loc.gov/2012379877"}, {"access_restricted": false, "aka": ["http://lccn.loc.gov/89601436", "http://www.loc.gov/item/89601436/", "http://www.loc.gov/resource/gdcmassbookdig.tampasarasotabay00unit/", "https://hdl.loc.gov/loc.gdc/scd0001.00117838717", "http://www.loc.gov/resource/scd0001.00117838717/"], "campaigns": [], "contributor": ["united states. noaa estuarine programs office"], "date": "1989", "dates": ["1989"], "description": ["\"February 1989\"--Cover. Includes bibliographical references. Also available in digital form."], "digitized": true, "extract_timestamp": "2025-08-27T07:58:12.583Z", "group": ["paprika-iabooks", "catalog-split-05", "catalog", "main-catalog-split-05"], "hassegments": true, "id": "http://www.loc.gov/item/89601436/", "image_url": ["https://tile.loc.gov/image-services/iiif/public:gdcmassbookdig:tampasarasotabay00unit:tampasarasotabay00unit_0005/full/pct:6.25/0/default.jpg", "https://tile.loc.gov/image-services/iiif/public:gdcmassbookdig:tampasarasotabay00unit:tampasarasotabay00unit_0005/full/pct:6.25/0/default.jpg#h=269&w=186", "https://tile.loc.gov/image-services/iiif/public:gdcmassbookdig:tampasarasotabay00unit:tampasarasotabay00unit_0005/full/pct:12.5/0/default.jpg#h=538&w=372", "https://tile.loc.gov/image-services/iiif/public:gdcmassbookdig:tampasarasotabay00unit:tampasarasotabay00unit_0005/full/pct:25.0/0/default.jpg#h=1077&w=745", "https://tile.loc.gov/image-services/iiif/public:gdcmassbookdig:tampasarasotabay00unit:tampasarasotabay00unit_0005/full/pct:50.0/0/default.jpg#h=2155&w=1490", "https://tile.loc.gov/image-services/iiif/public:gdcmassbookdig:tampasarasotabay00unit:tampasarasotabay00unit_0005/full/pct:100.0/0/default.jpg#h=4310&w=2981"], "index": 6, "language": ["english"], "location": ["tampa bay", "sarasota bay", "florida"], "mime_type": ["text/xml", "image/jpeg", "image/jp2", "application/pdf", "application/json", "text/plain"], "number": ["89601436", "2018-08-07t10:53:12"], "online_format": ["online text", "image", "pdf"], "original_format": ["book"], "partof": ["selected digitized books", "catalog", "general collections"], "score": 20.02949, "shelf_id": "https://repo.loc.gov/access/public/gdcmassbookdig/tampasarasotabay00unit/.resource.json", "site": ["catalog"], "subject": ["water resources development", "congresses", "tampa bay", "water quality", "aquatic ecology", "florida", "sarasota bay"], "timestamp": "2025-08-27T12:12:22.070Z", "title": "Tampa and Sarasota Bays : issues, resources, status, and management : proceedings of a seminar, held December 10, 1987, Washington, D.C.", "type": ["text"], "url": "https://www.loc.gov/item/89601436/"}], "reproductions": "<p>\nSome images in this collection are described in groups; others are \ndescribed individually. In some cases, all of the images in the \ngroup display online, in other cases they do not.\n</p>\n\n<p>\nYou can download online images yourself.  Alternatively, you can \npurchase copies of various types.\n</p>\n\n<ol>\n<p>\t\n<strong><li>Determine whether the desired materials can be retrieved \nonline.</strong>\n</p>\n<ul>\n<p>\t\n<li>Look in the <strong>Medium</strong> field above to determine whether\n the description is for one photograph or more than one.</li>\n </p>\n <p>\n<li>If the description is for a single item and it is displaying, \nyou can download or purchase a print.  Cite the number that begins \nwith &quot;LC-DIG...&quot; when purchasing copies through Library of \nCongress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is \na &quot;Click for more images&quot; icon displaying, select that. \nIndividual images will display; you can download or purchase prints. \nCite the number that begins with &quot;LC-DIG...&quot; when purchasing \ncopies through Library of Congress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is no\n &quot;Click for more images&quot; icon displaying, return to the\n  &quot;About this Item&quot; tab and select the &quot;<i>Check for \n  online items from this group</i>&quot; link.  Then select the \n  \"Obtaining Copies\" tab for any retrieved items that are of interest.\n</p>\n</ul>\n</li>\n\n<p>\n<strong><li>If the images do not display online</strong> -- Select images for reproduction through one of these methods:\n</p>\n<ul>\n<p>\t\n<li>Visit the Prints &amp; Photographs Reading Room and request to view \nthe group (general information about service in the reading room is \navailable at: <a href=\"//www.loc.gov/rr/print/info/001_ref.html\">https://www.loc.gov/rr/print/info/001_ref.html</a>).</li>  \n</p>\n<p>\n<li>P&amp;P reading room staff can provide up to 15 photocopies of items \nper calendar year. (Color images cannot be photocopied.) For assistance,\n see our <a href=\"//www.loc.gov/rr/askalib/ask-print.html\">Ask a Librarian</a> page. OR</li>\n</p>\n<p>\n<li>Hire a freelance researcher to do further selection for you \n(a list of researchers is available at: \n<a href=\"//www.loc.gov/rr/print/resource/013_pic.html\">https://www.loc.gov/rr/print/resource/013_pic.html</a>).\n</p>\n</ul>\n</li>\n</ol>\n\n<p>\n<strong>Purchasing Copies</strong>\n</p>\n\n<p>\nLibrary of Congress Duplication Services can make copies of various \ntypes from images in Prints & Photographs Division Collections.  \nPrice lists, contact information, and order forms are available on the \n<a href=\"//www.loc.gov/duplicationservices/\">Duplication Services Web site</a>.\n</p>\n\n<p>\nCarol M. Highsmith sells prints of her photographs at: <a href=\"http://photographsamerica.com/\">http://photographsamerica.com/</a> .\n</p>  \n\n\n\n\n        ", "resources": [{"caption": "digital file from original", "files": [[{"height": 500, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:12100:12184/full/pct:12.5/0/default.jpg", "width": 375}, {"height": 1000, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:12100:12184/full/pct:25/0/default.jpg", "width": 750}, {"height": 2001, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:12100:12184/full/pct:50/0/default.jpg", "width": 1500}, {"height": 4003, "info": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:12100:12184/info.json", "levels": 7, "mimetype": "image/jp2", "size": 2681725, "url": "https://tile.loc.gov/storage-services/service/pnp/highsm/12100/12184.jp2", "width": 3000}]], "image": "https://tile.loc.gov/storage-services/service/pnp/highsm/12100/12184t.gif", "url": "https://www.loc.gov/resource/highsm.12184/"}], "thesaurus_entry": null, "timestamp": 1795314502337, "unrestricted": true}