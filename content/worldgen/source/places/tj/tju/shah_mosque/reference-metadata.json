  "currentRoundInspection": {
    "inspectedOn": "2026-10-17",
    "scope": "Four actually inspected2014 square entrance,court,madrasa/dome and muqarnas pictures plus standard viewer PMTiles/DEM. No bespoke surveys or redistributed photographs;unseen roofs/current finish and precise ground joins unverified.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Entrance_iwan_and_dome_of_Shah_Mosque_Isfahan_2014_(1).jpg",
        "author": "Radosław Botev / Fundacja Nomos",
        "date": "2014-04-07",
        "license": "CC-BY-3.0-PL",
        "observed": "Square-facing entrance iwan with blue/cyan tile frame and twin slender turquoise minarets/open upper galleries. Main rounded turquoise dome and rear minarets appear behind at the different prayer-axis angle. Adjacent two-tier square facades are separate host content;scaffolding and public-square furniture excluded."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Courtyard_iwans_Shah_Mosque_Isfahan_2014_(2).jpg",
        "author": "Radosław Botev / Fundacja Nomos",
        "date": "2014-04-07",
        "license": "CC-BY-3.0-PL",
        "observed": "Main court with tall tiled prayer iwan and twin minarets,lower side iwan topped by an open timber pavilion/pyramidal cyan cap,two-tier pointed courtyard fields and large central rectangular water basin. Main prayer arch is a deep vaulted recess;tile art/calligraphy are abstracted with generic shared mosaic."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Madrasa_and_dome_exterior_of_Shah_Mosque_Isfahan_2014_(2).jpg",
        "author": "Radosław Botev / Fundacja Nomos",
        "date": "2014-04-07",
        "license": "CC-BY-3.0-PL",
        "observed": "Side madrasa has lower single-tier pointed recesses/tiled spandrels,sand-colored brick upper wall and lower closed lattice fields around the tall pale transition under the turquoise dome. Narrow cypress planting/garden bed in the courtyard. Historic dome scaffolding not modeled."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Entrance_iwan_muqarnas_of_Shah_Mosque_Isfahan_2014_(2).jpg",
        "author": "Radosław Botev / Fundacja Nomos",
        "date": "2014-04-07",
        "license": "CC-BY-3.0-PL",
        "observed": "Upward close view of layered faceted muqarnas above closed entrance doorway,with blue/cyan/light-gold tile fields and broad inscription band. Model uses a few original large facets and shared low-frequency mosaic,not copied patterns or inscriptions."
      }
    ]
  }
