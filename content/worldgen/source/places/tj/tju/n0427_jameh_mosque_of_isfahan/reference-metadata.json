  "currentRoundInspection": {
    "inspectedOn": "2026-10-16",
    "scope": "Five actually inspected2011–2018 courtyard/iwan/north-exterior pictures plus standard viewer PMTiles/DEM. No bespoke surveys or redistributed photographs;current finish unverified.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:20180301124354_IMG_4179And6more_Interior_3.jpg",
        "author": "Hamidespanani",
        "date": "2018-03-01",
        "license": "CC-BY-SA-4.0;viewed only,not redistributed",
        "observed": "Inspected960×639 courtyard overview:three visible monumental pointed iwans,south twin cylindrical minarets,two-storey pointed arcade ranges,blue/cyan tile fields and pale brick walls. Large blue court basin;raised low gallery walk. East iwan is more bare brick with layered muqarnas;west tile-clad iwan has tiny timber lookout. Facade art/portraits/banners omitted."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Jameh_Mosque_of_Isfahan_-_Northern_Iwan.jpg",
        "author": "Bernard Gagnon",
        "date": "2016-10-29",
        "license": "CC-BY-SA-4.0;viewed only,not redistributed",
        "observed": "Inspected960×640 north iwan:wide deep pointed brick barrel vault with plain planar flanks and small lower side recesses;tile border/geometric spandrels,large rectangular portal frame. Adjacent two-storey narrow pointed blind/open bays with lattice panes and generic tiled spandrels. Fine lattice,inscriptions and actual brick patterns abstracted."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Masjed-e_J%C4%81m%C3%A9_of_Isfahan.jpg",
        "author": "Fabian Balles",
        "date": "2011-01-05",
        "license": "CC-BY-SA-4.0;viewed only,not redistributed",
        "observed": "Inspected960×640 historical dusk courtyard:whole south iwan/twin capped shafts,brick-colored rounded south dome behind its left shoulder;west iwan with projecting timber lookout;small arched court pavilion. Used for silhouette/depth only;night illumination is not baked into the model."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Exterior_and_north_dome_Jameh_Mosque_of_Isfahan.jpg",
        "author": "Hamed fattahi",
        "date": "2015-03-28",
        "license": "CC-BY-SA-4.0;viewed only,not redistributed",
        "observed": "Inspected960×640 north exterior:unpainted pale tan brick,pointed lattice fields in plain outside wall,rounded low-shouldered brick dome above faceted/square transition with shallow pointed panels. Small parapet/coping and projecting drain ends;no turquoise tiled principal dome. Dimensions and unseen roof arrangement remain estimates."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Jameh_Mosque_of_Isfahan_-_Western_Iwan_01.jpg",
        "author": "Bernard Gagnon",
        "date": "2016-10-29",
        "license": "CC-BY-SA-4.0;viewed only,not redistributed",
        "observed": "Inspected960×646 west iwan:deep broad pointed recess with a few large faceted muqarnas cells,cyan/cream patterned rectangular frame,projecting open timber lookout with little pyramidal cap. Two-storey tiled arcade bays and low arched square stone/brick court pavilion over blue basin. Abstract cell geometry and shared generic mosaic,not copied facade artwork."
      }
    ]
