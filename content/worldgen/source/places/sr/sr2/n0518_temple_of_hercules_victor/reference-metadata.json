    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:L06_725_Tempel_des_Hercules_Victor.jpg",
        "author": "Falk2 / Falk Arnhold",
        "date": "2025-10-20",
        "license": "CC BY-SA4.0; viewed only",
        "observations": "Actually inspected full frontal photograph: broad shallow tiled cone roof, plain low eave without ancient entablature, fluted weathered shafts with Corinthian crowns and some protective metal straps, round upper brick cella, pale lower wall panels and tall dark arched closed entrance. Garden, iron fence, people and street furniture establish context but are not copied into the temple asset. No pixels copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Temple_Hercule_(Rome)_-_Chapiteaux.JPG",
        "author": "Ursus",
        "date": "2012 (EXIF2012-05-06)",
        "license": "CC BY-SA3.0; viewed only",
        "observations": "Actually inspected full capital detail: two main leaf tiers, large curling corners, shallow scalloped abacus, eroded flute ends/drum joins and grey protective bands. Exposed brown timber rafters/ring beams sit immediately below the tiled roof; the upper brick cella includes an arched doorway surround. Use broad recognition geometry rather than a micro-carved inventory."
      }
    ]
