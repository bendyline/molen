  "currentRoundInspection": {
    "inspectedOn": "2026-10-19",
    "scope": "Present-day roofless Temple of Vesta in the Roman Forum: circular exposed-brick podium, three tall fluted Corinthian columns and one mapped stump, northwest curved marble cella/entablature sector, and individually mapped low ruin fragments. The missing roof and remaining historic colonnade are not reconstructed. Independent Forum ruins remain native.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Temple_of_Vesta_(Rome).jpg",
        "author": "Wknight94",
        "license": "CC BY-SA3.0; viewed only.",
        "date": "2008-04-26",
        "observations": "Three tall outer fluted columns, curved architrave/frieze/cornice fragment, two inner engaged pilasters, marble cella sector and paneled podium. Surviving sector faces northwest; the photo is taken from the northwest. Left adjoining low column stump. No roof or complete colonnade survives."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Temple_of_Vesta_Forum_Romanum_Rome.jpg",
        "author": "Jebulon",
        "license": "CC0; viewed only.",
        "date": "2013-08-22",
        "observations": "Closer surviving sector: shaft flutes, tiered bases, faceted Corinthian capital masses, fragmentary dentil cornice and exposed panel fields. Lower column stump and broken masonry on either side. Detail must stay medium-fi, with selected coarse flutes/leaf lobes rather than copied relief."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Temple_Vesta_Forum_Romanum_Rome_Italy.jpg",
        "author": "Jebulon",
        "license": "CC0; viewed only.",
        "date": "2013-08-22",
        "observations": "Southeastern/reverse context view shows the surviving high marble sector at the northwest of the roofless circular brick podium, brick courses exposed around the lower ring and low irregular ruin stubs. Separate surrounding Roman Forum ruins must remain independent."
      }
    ]
  }
