    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Rome_-_Temple_of_Venus_and_Rome_(5178790722).jpg",
        "author": "Dennis G. Jarvis",
        "date": "2010-10-10",
        "license": "CC BY-SA2.0; viewed only",
        "observations": "Actually inspected full east-facing view: a tall broad brick apse with a diamond-coffered half dome, broken cella side walls, bare white/grey standing shafts on both sides, low steps, grassy broad platform and scattered pale fragments. Church, bell tower and museum behind it are independent later buildings."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Tempio_di_Venere_e_Roma_-_abside_-_antmoose.jpg",
        "author": "Anthony Majanlahti",
        "date": "2005-08-23",
        "license": "CC BY2.0; viewed only",
        "observations": "Actually inspected the illuminated oblique exterior: deep concave lower apse, a surviving diamond-coffered conch with thick arch rim, irregular brick side returns and roof loss. The lit appearance is not baked into materials."
      }
    ]
