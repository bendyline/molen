  "currentRoundInspection": {
    "inspectedOn": "2026-10-16",
    "scope": "Four actually inspected exterior/detail pictures plus standard viewer PMTiles/DEM. No bespoke surveys or redistributed pictures.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Kotor_Cathedral_church.jpg",
        "author": "Geotiger18",
        "date": "2018-07-13",
        "license": "CC-BY-SA-3.0",
        "observed": "Inspected enlarged whole southwest facade: unequal pale square towers, shorter north plain rectangular top and taller south arched belfry with shallow caps/crosses; cornice stages, arched window balconies/pediments, clocks and large rose. Open round-vaulted porch supports a stone balustraded terrace. Long stone south wall has a small blind arcade below the roof. Umbrellas/cafe canopies and neighboring houses hide the base and roof joins and remain excluded."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Cattaro,_san_trifone,_ext,_abside_del_xii_sec._01.JPG",
        "author": "Sailko",
        "date": "2015-06-18",
        "license": "CC-BY-3.0",
        "observed": "Inspected rounded east apse with coursed stone, red curved tile eaves, short blind round arches below the cornice, tall framed bifora/recessed lights and shallow round decorative openings. Smaller flank apse visible to right; high east wall behind has a line of small blind arches. Narrow lane/adjoining houses and hidden roof connections remain approximate."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Cattaro,_san_trifone,_ext,_abside_del_xii_sec._04.JPG",
        "author": "Sailko",
        "date": "2015-06-18",
        "license": "CC-BY-3.0",
        "observed": "Inspected apse stone carving/cornice detail: shallow carved animal/foliage, rope border and projecting dentils. These reliefs are deliberately abstracted into broad stone trim rather than copied as a photograph or fine sculpted mesh."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Cattaro,_san_trifone,_ext_05.JPG",
        "author": "Sailko",
        "date": "2015-06-18",
        "license": "CC-BY-3.0",
        "observed": "Inspected porch-vault and terrace close view: open pale curved vault, projecting arch ring/pediment molding, squat stone balusters and handrail, with triangular church gable/rose behind. Carved masks/foliage abstracted; no photograph is redistributed."
      }
    ]
  }
