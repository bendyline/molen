": ["image"], "original_format": ["map"], "partof": ["cities and towns", "geography and map division", "catalog", "panoramic maps"], "score": 24.200209, "shelf_id": "G3954.F7A3 1871 .R8", "site": ["catalog"], "subject": ["kentucky", "united states", "frankfort", "frankfort (ky.)", "aerial views"], "timestamp": "2026-08-08T14:01:48.472Z", "title": "Bird's eye view of the city of Frankfort, the capital of Kentucky 1871", "type": ["cartographic"], "url": "https://www.loc.gov/item/73693413/"}, {"access_restricted": false, "aka": ["http://lccn.loc.gov/86691123", "http://www.loc.gov/item/86691123/", "https://search.catalog.loc.gov/instances/b8b434f4-763e-5c01-88b2-f7a2a0c8d6d0", "https://hdl.loc.gov/loc.gmd/g3954f.cw0220500", "http://www.loc.gov/resource/g3954f.cw0220500/"], "campaigns": [], "contributor": ["brooks, j. h.", "poe, o. m. (orlando metcalfe)"], "date": "1863", "dates": ["1863"], "description": ["Shows streets, rivers and creeks, locations of the arsenal and \"U.S. Hd. Qrs.,\" and recommended defensive positions. Annotated in blue pencil : Positions for defensive works proferred [sic] by Col. Gilbert with force and armament marked blue. Relief shown by hachures and spot heights. Annotated in ink: A correct copy, [signed] T.B. Brooks, Capt. N.Y. Vol. Engrs. A.D.C., Engineers Office, District of Central Kentucky, Lexington, Ky., Feb. 18, 1863. Also annotated on verso: Vicinity of Frankfort. T.B. Brooks, 1862, No. 26. Pen and ink. LC Civil War maps (2nd ed.) 220.5 Available also through the Library of Congress Web site as a raster image. Vault"], "digitized": true, "extract_timestamp": "2026-04-29T15:39:52.622Z", "group": ["gmd.mar", "catalog-split-04", "catalog", "general-maps", "main-catalog-split-04"], "hassegments": false, "id": "http://www.loc.gov/item/86691123/", "image_url": ["https://tile.loc.gov/storage-services/service/gmd/gmd395/g3954/g3954f/cw0220500.gif", "https://tile.loc.gov/storage-services/service/gmd/gmd395/g3954/g3954f/cw0220500.gif#h=150&w=207", "https://tile.loc.gov/image-services/iiif/service:gmd:gmd395:g3954:g3954f:cw0220500/full/pct:12.5/0/default.jpg#h=1103&w=1525", "https://tile.loc.gov/image-services/iiif/service:gmd:gmd395:g3954:g3954f:cw0220500/full/pct:25/0/default.jpg#h=2206&w=3050"], "index": 6, "language": ["english"], "location": ["frankfort", "kentucky", "united states"], "mime_type": ["image/gif", "image/tiff", "image/jpeg", "image/jp2"], "number": ["86691123", "2025-06-07t18:37:10.400000", "sheet", "2021-08-25t11:23:20"], "online_format": ["image"], "original_format": ["map"], "partof": ["geography and map division", "military battles and campaigns", "civil war maps", "catalog"], "score": 24.200209, "shelf_id": "G3954.F7S5 1863 .B7", "site": ["catalog"], "subject": ["kentucky", "civil war", "manuscript maps", "united states", "maps", "maps, manuscript", "fortification", "history", "frankfort", "frankfort (ky.)"], "timestamp": "2026-04-29T16:22:42.634Z", "title": "Military map of the vicinity of Frankfort, Kentucky", "type": ["cartographic"], "url": "https://www.loc.gov/item/86691123/"}], "reproductions": "<p>\nSome images in this collection are described in groups; others are \ndescribed individually. In some cases, all of the images in the \ngroup display online, in other cases they do not.\n</p>\n\n<p>\nYou can download online images yourself.  Alternatively, you can \npurchase copies of various types.\n</p>\n\n<ol>\n<p>\t\n<strong><li>Determine whether the desired materials can be retrieved \nonline.</strong>\n</p>\n<ul>\n<p>\t\n<li>Look in the <strong>Medium</strong> field above to determine whether\n the description is for one photograph or more than one.</li>\n </p>\n <p>\n<li>If the description is for a single item and it is displaying, \nyou can download or purchase a print.  Cite the number that begins \nwith &quot;LC-DIG...&quot; when purchasing copies through Library of \nCongress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is \na &quot;Click for more images&quot; icon displaying, select that. \nIndividual images will display; you can download or purchase prints. \nCite the number that begins with &quot;LC-DIG...&quot; when purchasing \ncopies through Library of Congress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is no\n &quot;Click for more images&quot; icon displaying, return to the\n  &quot;About this Item&quot; tab and select the &quot;<i>Check for \n  online items from this group</i>&quot; link.  Then select the \n  \"Obtaining Copies\" tab for any retrieved items that are of interest.\n</p>\n</ul>\n</li>\n\n<p>\n<strong><li>If the images do not display online</strong> -- Select images for reproduction through one of these methods:\n</p>\n<ul>\n<p>\t\n<li>Visit the Prints &amp; Photographs Reading Room and request to view \nthe group (general information about service in the reading room is \navailable at: <a href=\"//www.loc.gov/rr/print/info/001_ref.html\">https://www.loc.gov/rr/print/info/001_ref.html</a>).</li>  \n</p>\n<p>\n<li>P&amp;P reading room staff can provide up to 15 photocopies of items \nper calendar year. (Color images cannot be photocopied.) For assistance,\n see our <a href=\"//www.loc.gov/rr/askalib/ask-print.html\">Ask a Librarian</a> page. OR</li>\n</p>\n<p>\n<li>Hire a freelance researcher to do further selection for you \n(a list of researchers is available at: \n<a href=\"//www.loc.gov/rr/print/resource/013_pic.html\">https://www.loc.gov/rr/print/resource/013_pic.html</a>).\n</p>\n</ul>\n</li>\n</ol>\n\n<p>\n<strong>Purchasing Copies</strong>\n</p>\n\n<p>\nLibrary of Congress Duplication Services can make copies of various \ntypes from images in Prints & Photographs Division Collections.  \nPrice lists, contact information, and order forms are available on the \n<a href=\"//www.loc.gov/duplicationservices/\">Duplication Services Web site</a>.\n</p>\n\n<p>\nCarol M. Highsmith sells prints of her photographs at: <a href=\"http://photographsamerica.com/\">http://photographsamerica.com/</a> .\n</p>  \n\n\n\n\n        ", "resources": [{"caption": "original digital file", "files": [[{"height": 0, "levels": 1, "mimetype": "image/tiff", "size": 315385480, "url": "https://tile.loc.gov/storage-services/master/pnp/highsm/63800/63835u.tif", "width": 0}, {"height": 0, "levels": 1, "mimetype": "image/tiff", "size": 630753970, "url": "https://tile.loc.gov/storage-services/master/pnp/highsm/63800/63835a.tif", "width": 0}, {"height": 100, "levels": 1, "mimetype": "image/jpeg", "size": 86171, "url": "https://tile.loc.gov/storage-services/service/pnp/highsm/63800/63835_150px.jpg", "width": 150}, {"height": 425, "levels": 1, "mimetype": "image/jpeg", "size": 143901, "url": "https://tile.loc.gov/storage-services/service/pnp/highsm/63800/63835r.jpg", "width": 640}, {"height": 680, "levels": 1, "mimetype": "image/jpeg", "size": 576999, "url": "https://tile.loc.gov/storage-services/service/pnp/highsm/63800/63835v.jpg", "width": 1024}]], "image": "https://tile.loc.gov/storage-services/service/pnp/highsm/63800/63835_150px.jpg", "url": "https://www.loc.gov/resource/highsm.63835/"}], "thesaurus_entry": null, "timestamp": 1795305024151, "unrestricted": true}