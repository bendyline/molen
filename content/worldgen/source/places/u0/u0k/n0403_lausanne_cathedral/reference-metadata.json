  "currentRoundInspection": {
    "inspectedOn": "2026-10-16",
    "scope": "Five actually inspected exterior pictures and standard viewer PMTiles/DEM. No bespoke survey research or redistributed pictures.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Lausanne-cathe7.JPG",
        "author": "Arnaud Gaillard",
        "date": "2004-05-15",
        "license": "CC-BY-SA-2.0",
        "observed": "Inspected enlarged east view: exceptionally tall dark crossing spire over a pale pointed/gabled crown, shorter western arcaded tower with red roof, two squat eastern towers with steep red pyramids, rounded choir and low roofs. Foreground town buildings/trees hide the base."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Vue_a%C3%A9rienne_de_la_cath%C3%A9drale_de_Lausanne.jpg",
        "author": "Bernard Vogel",
        "date": "2019-04-20",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected enlarged aerial exterior: long red-tiled nave with flying buttresses, massive western tower blank lower shaft and two open arcaded stages, four corner pinnacles and red cap; very tall slate crossing spire with pale arrises, open gabled crown and lower pointed windows. Smaller red-roofed east towers and south gable visible. Tall spire tip and lower ground are cropped."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Cath%C3%A9drale_de_Lausanne,_southern_side.jpg",
        "author": "Hendrik Heiser",
        "date": "2018-09-23",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected enlarged south view: large rose with pale radial/tracery divisions, three tall round lights beneath, shallow arcaded/gabled upper front, painted porch with high pointed arch and steep little red roof, regular nave clerestory and flying buttresses, stepped western tower buttresses. Works hide part of the porch base; sculpture is simplified."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:West_side_of_Cath%C3%A9drale_de_Lausanne.jpg",
        "author": "Abxbay",
        "date": "2022-07-20",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected cropped west-front close view: tall pointed glazed entrance above a lower timber door, layered pale stone portal bands, flat sculptural register and stepped tower buttresses with two arcaded stages above. It does not show the complete west block or prove a north roof profile."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Lausanne_Cath%C3%A9drale_Notre-Dame_01.jpg",
        "author": "Zairon",
        "date": "2013-01-12",
        "license": "CC-BY-SA-3.0",
        "observed": "Inspected west entrance/base: tall pointed portal and slender jambs, glazed upper field and rectangular dark lower door, pale figure frieze, small open-arch register/parapet above and massive stepped bell-tower piers. Upper tower and most northwest block are cropped."
      }
    ]
  }
