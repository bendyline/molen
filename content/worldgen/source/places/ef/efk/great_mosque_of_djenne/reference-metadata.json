  "currentRoundInspection": {
    "inspectedOn": "2026-10-16",
    "scope": "Four actually inspected1972/1990/2005/2007 facade/roof/entrance pictures plus standard viewer PMTiles/DEM. No bespoke surveys or redistributed photographs;current finish unverified.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Moschee_von_Djenn%C3%A9.jpg",
        "author": "qiv",
        "date": "2007-09-10",
        "license": "CC-BY-SA-2.0",
        "observed": "Inspected960×640 front/market picture:three broad tapering adobe towers with stepped upper shoulders,long conical tips and pale egg-like finials;central tower taller. Tapered front buttresses continue into pointed roofline pinnacles. Dense rows of projecting dark toron timber across towers and facade. Smooth warm earth plaster without exposed brick joints. Raised perimeter platform;market vehicles and people excluded."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Djenn%C3%A9_Moschee(Dach)1990.jpg",
        "author": "Albert Backer",
        "date": "1990-01-21",
        "license": "CC-BY-SA-3.0",
        "observed": "Inspected500×666 roof-side close view:rounded/chamfered tower shoulders,stepped square upper masses and tapering pointed caps,small pale finials,irregular paired/triple dark projecting timber pegs. Thick pointed roof parapet with small drainage openings at its foot. Recessed roof-side door/light fields. Exact current finish,individual timber count and unseen court elevations unverified."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Mosque_entrance_(6862566).jpg",
        "author": "upyernoz",
        "date": "2005-03-19",
        "license": "CC-BY-2.0",
        "observed": "Inspected500×775 entrance view:paired rectangular dark entrances in tall recessed panels,separate square ventilation lights,thick tapering pilasters and pointed crenellations. Broad irregular stair flight with heavy mud-plastered cheek walls and upward-pointed landing ends. Timber rows are widely spaced here. Small signage/people omitted;precise gate identification and dimensions remain approximate."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:La_Grande_mosqu%C3%A9e,_Djenn%C3%A9,_Mali._Le_toit_et_ses_%C3%A9vents_d%27a%C3%A9ration._Date_du_clich%C3%A9_1972-12-27.jpg",
        "author": "Gilles MAIRET",
        "date": "1972-12-27 (capture;2013 file date)",
        "license": "CC-BY-SA-3.0",
        "observed": "Inspected960×640 roof view:flat earthen roof with many low tapering vent collars and small terracotta lids;rear faces of main towers carry stepped shoulders,recessed rectangular/pointed roof entries and timber beams. Pointed parapets include small low drainage openings. Historical roof arrangement is a shape reference;current vent count,interiors and courtyard elevations unverified."
      }
    ]
  }
