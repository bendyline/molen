    {
      "url": "https://grimshaw.global/news/articles/archive/london-stratford-station-and-public-realm-design/",
      "imageUrl": "https://grimshaw.global/assets/crops/Crop.ce595a3e.crop.2f503854.stratford02.jpg",
      "observed": "Inspected whole regional-station aerial:large warm metallic broad barrel/sweeping hallroof withglazed lowedge,separate longsilver platformcanopies,curving northwest canopy,shortsouthernbranch roofs,rust-colored glazed sideframe crossingfulllinecorridor. KeepWestfield/officetowers/busstation separate. Fine roofsections andbelowgrade elevations remain approximate."
    },
    {
      "url": "https://studioegretwest.com/places/stratford",
      "imageUrl": "https://studioegretwest.com/assets/images/places/_large/Stratford_Studio-Egret-West_Image-8.jpg",
      "observed": "Inspected MeridianSquare evening exterior:whole longglazed hallfront withsloping inward/upward curtainplane,deepmetal roofedge,visible paleinteriorroofcolumns/diagonal braces,low projectingentry canopy. No copiedlettering,Olympic stadium,temporarytents,sculpture orsigns."
    },
    {
      "url": "https://www.5thstudio.co.uk/projects/stratford-station-urban-design-framework/",
      "imageUrl": "https://cdn.sanity.io/images/4kokwq76/production/b7057de2cfd152e78b7ff110026441536a63fe60-1200x900.jpg?auto=format&fit=clip&q=82",
      "observed": "Inspected footbridge aerial:whole broadopen-top crossing withrust-red parallel deepedgebeams,tall glazed/parapet sidebays,closelyspaced darkposts andpale deck;endlandings/columns acrossalltracks. Visiblecanopyroofs havepaleopaque metalbands andnarrow skylights. No copiedadverts,people ortrains."
    },
    {
      "url": "https://build.protomaps.com/20261031.pmtiles",
      "observed": "Complete aboveground Stratford regional interchange exterior:whole sweeping Meridian Square ticket hall/main roof andwest platform extension;both long mainline island canopies;curved northwestern Overground-platform canopy andservice shelters;four southern Jubilee/DLR platform-canopy outlines;east glazed entry/lift andMeridian facade canopy;complete mapped rust-framed glazed public footbridge across therails,including approximate southlanding/stairs. Stratford International,Westfield mall,adjacent office/retail towers,busstation,independentstreets andnonstationbuildings remain separate. Underground interiors,trains,people,lettering,roundels andadvertising are omitted. Current PMTiles mainparent height11m retained asmainroof crown;canopy531andfour southerncanopies native5m retained asrooftops. The mainroof fillsmapedge service/notch gaps withanordinary-picture convex roof-envelope interpretation;actual occupiedfloorremains theinset mainhall only. Layer-1 doesnot establish surveyed platformgrade. Eaves5.4m,glasswall6m,platform .3m,mainfloor .65m,mainfootbridgefloor7.8m/side11m andauxiliaryserviceheights areexplicit photo/map approximations. Footbridgefollows current mappedpath35184502965940;its fullphysical crossingisclaimed,not thewhole adjoiningmall."
    }
