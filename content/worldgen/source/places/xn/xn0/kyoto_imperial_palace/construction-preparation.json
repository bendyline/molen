  "primaryWrittenSources": [
    {
      "url": "https://kyoto-gosho.kunaicho.go.jp/en/building/2A1",
      "facts": "The 1855 Shishinden is a one-story, south-facing, natural timber frame with a cypress bark roof and a central Moya surrounded by eaves and ancillary aisles."
    },
    {
      "url": "https://kyoto-gosho.kunaicho.go.jp/api/booklet-volumes/S02/file",
      "facts": "The Imperial Household Agency booklet gives approximately 33 m by 23 m for the hall before the veranda and about 44 m by 33 m for the roof."
    },
    {
      "url": "https://www.kunaicho.go.jp/en/learn/institution/shisetsu/kyoto/kyoto-ph.html",
      "facts": "The Agency describes the ceremonial gates, Shishinden, Seiryoden, Kogosho and the residential Otsunegoten with a cypress bark hipped gable roof."
    },
    {
      "url": "https://www.kikuyou.or.jp/gosyo_rikyu/kyoto-gosyo.html",
      "facts": "The palace preservation association gives the Shishinden a 20.5 m overall height."
    },
    {
      "url": "https://www.kunaicho.go.jp/wp-content/uploads/2026/03/20260324-01.pdf",
      "facts": "The later conservation tender labels the 18-step Shishinden stair and documents temporary works for future roof renewal. The temporary enclosure is later than the represented date."
    },
    {
      "url": "https://kyoto-gosho.kunaicho.go.jp/en/gate/2C70",
      "facts": "Kenreimon is a four-support gate with a gabled cypress bark roof at the palace’s south end."
    },
    {
      "url": "https://kyoto-gosho.kunaicho.go.jp/en/building/2A2",
      "facts": "Seiryoden is a one-story raised timber building with a cypress bark roof and east-facing porch."
    },
    {
      "url": "https://kyoto-gosho.kunaicho.go.jp/en/building/2A4",
      "facts": "Kogosho is a one-story cypress-roofed ceremonial timber hall with latticed shutters."
    },
    {
      "url": "https://kyoto-gosho.kunaicho.go.jp/en/building/2A6",
      "facts": "Ogakumonjo stands north of Kogosho and southwest of Otsunegoten. Its timber building has a cypress bark roof."
    },
    {
      "url": "https://kyoto-gosho.kunaicho.go.jp/en/building/2A7",
      "facts": "Otsunegoten is the large one-story residential hall with its cypress bark roof."
    }
  ],
