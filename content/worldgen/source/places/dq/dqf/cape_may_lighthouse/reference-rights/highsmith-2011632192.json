p://www.loc.gov/item/sn90063041/1923-05-31/ed-1/", "22411850", "1", "microfilm service copy", "671", "2025-07-01t13:40:52.800000", "sn90063040", "2026-04-13t21:30:13", "2835-2084", "sn90063042", "2025-05-23t21:30:26"], "original_format": ["newspaper"], "partof": ["five mile beach weekly journal (wildwood, n.j.) 1906-1923", "serial and government publications division", "directory of u.s. newspapers in american libraries", "chronicling america", "catalog"], "publication_frequency": ["weekly"], "score": 24.164665, "shelf_id": "Newspaper", "site": ["chroniclingamerica", "usnd", "catalog"], "subject": ["newspapers", "united states", "cape may", "five mile beach", "wildwood", "wildwood (n.j.)", "new jersey"], "timestamp": "2026-10-25T12:59:44.636Z", "title": "Five Mile Beach weekly journal", "type": ["title"], "url": "https://www.loc.gov/item/sn90063041/"}, {"access_restricted": false, "aka": ["http://lccn.loc.gov/28027624", "http://www.loc.gov/item/28027624/", "https://search.catalog.loc.gov/instances/6841d8ea-a3a0-5296-9790-fe517157c8bf", "http://www.loc.gov/resource/law.00158958934/", "https://hdl.loc.gov/loc.law/llscd.201000158958934"], "campaigns": [], "contributor": ["united states. circuit court (middle circuit)", "williams, joannes", "brigstock, william", "evans, john"], "date": "1800", "dates": ["1800"], "description": ["Caption title. Dated on p. 3: March 1st, 1800. Signatures: A\u2074 chi\u2074. Includes The United States (v.) William Brigstock, otherwise called John Johnston, John Evans, otherwise called Michael Campbell, and Joannes Williams, otherwise called Joannes Williamson, indictment for piracy; The United States (a.) William Brigstock, otherwise called John Johnston, indictment for piracy; copies of habeus corpus (answer and commitment); copy of minutes, signed Robert Boggs, clerk of the said Court. Evans 38723 Also available in digital form on the Library of Congress Web site. Digital images not viewed; td12 2009-08-31 Recat. to AACR2: vj14 09-04-96."], "digitized": true, "extract_timestamp": "2026-08-12T19:52:24.424Z", "group": ["paprika-law", "catalog-split-15", "catalog", "main-catalog-split-15"], "hassegments": true, "id": "http://www.loc.gov/item/28027624/", "image_url": ["https://tile.loc.gov/image-services/iiif/public:law:00158958934:00005/full/pct:12.5/0/default.jpg", "https://tile.loc.gov/image-services/iiif/public:law:00158958934:00005/full/pct:12.5/0/default.jpg#h=469&w=311", "https://tile.loc.gov/image-services/iiif/public:law:00158958934:00005/full/pct:25.0/0/default.jpg#h=938&w=622", "https://tile.loc.gov/image-services/iiif/public:law:00158958934:00005/full/pct:50.0/0/default.jpg#h=1876&w=1244", "https://tile.loc.gov/image-services/iiif/public:law:00158958934:00005/full/pct:100.0/0/default.jpg#h=3752&w=2488"], "index": 6, "language": ["english"], "location": ["new jersey"], "mime_type": ["text/xml", "image/jpeg", "image/jp2", "application/pdf", "application/json", "text/plain"], "number": ["28027624", "http://www.loc.gov/resource/llscd.201000158958934", "2026-08-11t17:48:05.200000"], "online_format": ["online text", "image", "pdf"], "original_format": ["book"], "partof": ["piracy trials", "law library of congress", "catalog"], "score": 15.864249, "shelf_id": "KF223.B75 B75 1800", "site": ["catalog"], "subject": ["trials (murder)", "trials (piracy)", "trials, litigation, etc", "new jersey", "brigstock, william"], "timestamp": "2026-08-12T19:54:06.687Z", "title": "Circuit Court of the United States, Middle Circuit of the New-Jersey District, The United States, (a.) William Brigstock, otherwise called John Johnston, indictment for murder", "type": ["text"], "url": "https://www.loc.gov/item/28027624/"}], "reproductions": "<p>\nSome images in this collection are described in groups; others are \ndescribed individually. In some cases, all of the images in the \ngroup display online, in other cases they do not.\n</p>\n\n<p>\nYou can download online images yourself.  Alternatively, you can \npurchase copies of various types.\n</p>\n\n<ol>\n<p>\t\n<strong><li>Determine whether the desired materials can be retrieved \nonline.</strong>\n</p>\n<ul>\n<p>\t\n<li>Look in the <strong>Medium</strong> field above to determine whether\n the description is for one photograph or more than one.</li>\n </p>\n <p>\n<li>If the description is for a single item and it is displaying, \nyou can download or purchase a print.  Cite the number that begins \nwith &quot;LC-DIG...&quot; when purchasing copies through Library of \nCongress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is \na &quot;Click for more images&quot; icon displaying, select that. \nIndividual images will display; you can download or purchase prints. \nCite the number that begins with &quot;LC-DIG...&quot; when purchasing \ncopies through Library of Congress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is no\n &quot;Click for more images&quot; icon displaying, return to the\n  &quot;About this Item&quot; tab and select the &quot;<i>Check for \n  online items from this group</i>&quot; link.  Then select the \n  \"Obtaining Copies\" tab for any retrieved items that are of interest.\n</p>\n</ul>\n</li>\n\n<p>\n<strong><li>If the images do not display online</strong> -- Select images for reproduction through one of these methods:\n</p>\n<ul>\n<p>\t\n<li>Visit the Prints &amp; Photographs Reading Room and request to view \nthe group (general information about service in the reading room is \navailable at: <a href=\"//www.loc.gov/rr/print/info/001_ref.html\">https://www.loc.gov/rr/print/info/001_ref.html</a>).</li>  \n</p>\n<p>\n<li>P&amp;P reading room staff can provide up to 15 photocopies of items \nper calendar year. (Color images cannot be photocopied.) For assistance,\n see our <a href=\"//www.loc.gov/rr/askalib/ask-print.html\">Ask a Librarian</a> page. OR</li>\n</p>\n<p>\n<li>Hire a freelance researcher to do further selection for you \n(a list of researchers is available at: \n<a href=\"//www.loc.gov/rr/print/resource/013_pic.html\">https://www.loc.gov/rr/print/resource/013_pic.html</a>).\n</p>\n</ul>\n</li>\n</ol>\n\n<p>\n<strong>Purchasing Copies</strong>\n</p>\n\n<p>\nLibrary of Congress Duplication Services can make copies of various \ntypes from images in Prints & Photographs Division Collections.  \nPrice lists, contact information, and order forms are available on the \n<a href=\"//www.loc.gov/duplicationservices/\">Duplication Services Web site</a>.\n</p>\n\n<p>\nCarol M. Highsmith sells prints of her photographs at: <a href=\"http://photographsamerica.com/\">http://photographsamerica.com/</a> .\n</p>  \n\n\n\n\n        ", "resources": [{"caption": "digital file from original", "files": [[{"height": 431, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:13900:13998/full/pct:6.25/0/default.jpg", "width": 335}, {"height": 862, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:13900:13998/full/pct:12.5/0/default.jpg", "width": 671}, {"height": 1725, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:13900:13998/full/pct:25/0/default.jpg", "width": 1343}, {"height": 6903, "info": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:13900:13998/info.json", "levels": 7, "mimetype": "image/jp2", "size": 11528441, "url": "https://tile.loc.gov/storage-services/service/pnp/highsm/13900/13998.jp2", "width": 5372}]], "image": "https://tile.loc.gov/storage-services/service/pnp/highsm/13900/13998t.gif", "url": "https://www.loc.gov/resource/highsm.13998/"}], "thesaurus_entry": null, "timestamp": 1792945239012, "unrestricted": true}