source", "2026-04-13t21:30:13", "univ of texas at el paso", "univ of texas at austin", "2159-5623", "1", "sn88084263", "3372", "2025-11-07t15:02:46.100000", "sn86064199", "el paso pub libr", "sn88084272", "univ of virginia", "http://www.loc.gov/item/sn88084272/1910-01-03/ed-1/", "18614885", "sn86088892"], "original_format": ["newspaper"], "partof": ["el paso herald (el paso, tex.) 1901-1931", "catalog", "serial and government publications division", "chronicling america", "directory of u.s. newspapers in american libraries"], "publication_frequency": ["daily"], "score": 21.208578, "shelf_id": "Newspaper", "site": ["chroniclingamerica", "usnd", "catalog"], "subject": ["el paso county (tex.)", "el paso (tex.)", "texas", "newspapers", "el paso", "united states"], "timestamp": "2026-11-23T15:37:13.410Z", "title": "El Paso herald", "type": ["title"], "url": "https://www.loc.gov/item/sn88084272/"}, {"access_restricted": false, "aka": ["http://lccn.loc.gov/2006470518", "http://www.loc.gov/item/2006470518/", "http://purl.access.gpo.gov/GPO/LPS77063"], "campaigns": [], "contributor": ["united states. congress. house. committee on the judiciary"], "date": "2006", "dates": ["2006"], "description": ["Distributed to some depository libraries in microfiche. Shipping list no. unavailable. \"Serial no. 109-147.\" Includes bibliographical references. Also available via Internet from the GPO Access web site. Address as of 12/18/06: http://frwebgate.access.gpo.gov/cgi-bin/getdoc.cgi?dbname=109_house_hearings&docid=f:29604.pdf; current access is available via PURL."], "digitized": true, "extract_timestamp": "2023-06-02T17:51:37.516Z", "group": ["catalog-split-01", "catalog", "main-catalog-split-01", "main-catalog"], "hassegments": false, "id": "http://lccn.loc.gov/2006470518", "image_url": [], "index": 6, "language": ["english"], "location": ["texas", "el paso", "american border region", "mexico", "united states", "mexican"], "number": ["2022-03-03t11:25:19", "77065918", "2006470518"], "original_format": ["book"], "partof": ["catalog"], "score": 20.561949, "shelf_id": "KF27 .J8 2006d", "site": ["catalog"], "subject": ["illegal immigration", "border patrols", "crime", "emigration and immigration", "texas", "el paso", "foreign relations", "government policy", "mexico", "united states", "economic aspects", "mexican-american border region"], "timestamp": "2023-07-07T02:18:26.259Z", "title": "Should Mexico hold veto power over U.S. border security decisions? : hearing before the Committee on the Judiciary, House of Representatives, One Hundred Ninth Congress, second session, August 17, 2006.", "type": ["text"], "url": "//lccn.loc.gov/2006470518"}], "reproductions": "<p>\nSome images in this collection are described in groups; others are \ndescribed individually. In some cases, all of the images in the \ngroup display online, in other cases they do not.\n</p>\n\n<p>\nYou can download online images yourself.  Alternatively, you can \npurchase copies of various types.\n</p>\n\n<ol>\n<p>\t\n<strong><li>Determine whether the desired materials can be retrieved \nonline.</strong>\n</p>\n<ul>\n<p>\t\n<li>Look in the <strong>Medium</strong> field above to determine whether\n the description is for one photograph or more than one.</li>\n </p>\n <p>\n<li>If the description is for a single item and it is displaying, \nyou can download or purchase a print.  Cite the number that begins \nwith &quot;LC-DIG...&quot; when purchasing copies through Library of \nCongress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is \na &quot;Click for more images&quot; icon displaying, select that. \nIndividual images will display; you can download or purchase prints. \nCite the number that begins with &quot;LC-DIG...&quot; when purchasing \ncopies through Library of Congress Duplication Services.\n</p>\n<p>\n<li>If the description is for more than one item and there is no\n &quot;Click for more images&quot; icon displaying, return to the\n  &quot;About this Item&quot; tab and select the &quot;<i>Check for \n  online items from this group</i>&quot; link.  Then select the \n  \"Obtaining Copies\" tab for any retrieved items that are of interest.\n</p>\n</ul>\n</li>\n\n<p>\n<strong><li>If the images do not display online</strong> -- Select images for reproduction through one of these methods:\n</p>\n<ul>\n<p>\t\n<li>Visit the Prints &amp; Photographs Reading Room and request to view \nthe group (general information about service in the reading room is \navailable at: <a href=\"//www.loc.gov/rr/print/info/001_ref.html\">https://www.loc.gov/rr/print/info/001_ref.html</a>).</li>  \n</p>\n<p>\n<li>P&amp;P reading room staff can provide up to 15 photocopies of items \nper calendar year. (Color images cannot be photocopied.) For assistance,\n see our <a href=\"//www.loc.gov/rr/askalib/ask-print.html\">Ask a Librarian</a> page. OR</li>\n</p>\n<p>\n<li>Hire a freelance researcher to do further selection for you \n(a list of researchers is available at: \n<a href=\"//www.loc.gov/rr/print/resource/013_pic.html\">https://www.loc.gov/rr/print/resource/013_pic.html</a>).\n</p>\n</ul>\n</li>\n</ol>\n\n<p>\n<strong>Purchasing Copies</strong>\n</p>\n\n<p>\nLibrary of Congress Duplication Services can make copies of various \ntypes from images in Prints & Photographs Division Collections.  \nPrice lists, contact information, and order forms are available on the \n<a href=\"//www.loc.gov/duplicationservices/\">Duplication Services Web site</a>.\n</p>\n\n<p>\nCarol M. Highsmith sells prints of her photographs at: <a href=\"http://photographsamerica.com/\">http://photographsamerica.com/</a> .\n</p>  \n\n\n\n\n        ", "resources": [{"caption": "original digital file", "files": [[{"height": 397, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:26600:26637/full/pct:6.25/0/default.jpg", "width": 307}, {"height": 794, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:26600:26637/full/pct:12.5/0/default.jpg", "width": 614}, {"height": 1588, "levels": 1, "mimetype": "image/jpeg", "url": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:26600:26637/full/pct:25/0/default.jpg", "width": 1228}, {"height": 6355, "info": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:26600:26637/info.json", "levels": 7, "mimetype": "image/jp2", "size": 5678744, "url": "https://tile.loc.gov/storage-services/service/pnp/highsm/26600/26637.jp2", "width": 4912}]], "image": "https://tile.loc.gov/image-services/iiif/service:pnp:highsm:26600:26637/full/pct:6.25/0/default.jpg", "url": "https://www.loc.gov/resource/highsm.26637/"}], "thesaurus_entry": null, "timestamp": 1795487249301, "unrestricted": true}