  "currentRoundInspection": {
    "inspectedOn": "2026-10-15",
    "scope": "Three actually inspected2013 north exterior and2023 south-cloister photographs,plus standard viewer PMTiles/DEM only.No bespoke plans/surveys.Reference photos viewed only,not redistributed;fine carving/tracery approximated geometrically.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:St_Paul_Liege_Exterior.JPG",
        "author": "Juan Antonio Cordero",
        "date": "2013-06-08",
        "license": "CC-BY-SA-3.0",
        "observed": "Actually inspected whole north elevation from Cathedral Square. Gray coursed masonry,steep gray slate nave and transept roofs,tall pointed aisle windows and narrow clerestory bays;projecting transept gable has tall tracery and pinnacles. West square tower has paired tall louver arches,corner turrets and a long tapered gray spire with clock face near its foot,an upper open lantern and slim final point. Fine statues/crockets/clock lettering simplified."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Li%C3%A8ge_Clo%C3%AEtre_Saint-Paul_R08.jpg",
        "author": "Marc Ryckaert",
        "date": "2023-06-14",
        "license": "CC-BY-4.0",
        "observed": "Actually inspected south cloister garth close view. Gray ashlar church wall with tall pointed stained-glass windows,cream-yellow geometric mullions/foils,stepped buttresses and shallow pierced parapet. Low cloister side has smaller pointed traceried openings and an attached round stair turret with slate cone. Vegetation and artworks excluded;window colors represented by restrained shared glass,not photographic stained-glass textures."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Li%C3%A8ge_Clo%C3%AEtre_Saint-Paul_R14.jpg",
        "author": "Marc Ryckaert",
        "date": "2023-06-14",
        "license": "CC-BY-4.0",
        "observed": "Actually inspected court oblique showing full roof hierarchy. High slate nave,large south transept gable,upper blind pointed panels and tall main tracery window,step buttresses with pinnacles,lower aisle tracery/parapet. Separate low cloister range has a steep slate gable roof and small pointed dormers. Open garth must remain visible. Exact sculpture,interior bays and hidden roof partitions are approximate."
      }
    ]
  }
