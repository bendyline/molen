  "currentRoundInspection": {
    "inspectedOn": "2026-10-16",
    "scope": "Three actually inspected2012/2023 courtyard/exterior pictures plus standard viewer PMTiles/DEM. No bespoke surveys or redistributed photographs;current finish unverified.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Courtyard_of_the_Süleymaniye_Mosque_in_Istanbul,_Turkey_001.jpg",
        "author": "Moonik",
        "date": "2012-07-05",
        "license": "CC-BY-SA-3.0",
        "observed": "Inspected960×559 courtyard view toward outer northwest arcade:single tier of pointed arches on slender pale and reddish columns,alternating warm/pale voussoirs,low grey lead domes and raised central portal/dome/ornamental parapet. Rectangular marble fountain has three round-arched dark grille fields on its long face and a flat carved crown,not an open domed pavilion. Fine inscriptions,muqarnas,grilles and current finish remain abstracted."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Exterior_of_the_Süleymaniye_Mosque-.jpg",
        "author": "Yair Haklai",
        "date": "2023-04-16",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected960×354 overall exterior silhouette:dominant central lead-grey dome above a windowed drum,opposed longitudinal semi-domes and lower smaller caps,monumental side arched wall fields/buttresses,two taller three-balcony minarets beside the hall and two shorter two-balcony minarets at the courtyard end. Other domed complex buildings/city foreground are separate host content. Exact heights/fine details/current finish not surveyed."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Exterior_of_the_Süleymaniye_Mosque_in_Istanbul,_Turkey_002.jpg",
        "author": "Moonik",
        "date": "2012-07-05",
        "license": "CC-BY-SA-3.0",
        "observed": "Inspected full northeast facade portrait:central grey dome/window drum above stepped stone supports and lower caps;large pointed wall arches contain smaller pointed glazed/lattice fields. Tall square buttresses have small capped corner turrets. A lower exterior arcade carries round arches and a narrow upper arcade under projecting eaves beside ablution taps. Nearby minaret has faceted stone shaft,three projecting balcony collars and slender grey cone/finial. Fine carved supports,glazing patterns,taps and fixtures are omitted or simplified."
      }
    ]
  }
