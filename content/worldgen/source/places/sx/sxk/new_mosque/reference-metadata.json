  "currentRoundInspection": {
    "inspectedOn": "2026-10-17",
    "scope": "Three useful actually inspected courtyard/roof/exterior photographs and normal viewer PMTiles/DEM. SW flank0214 description showed it looked outward to a separate mausoleum,so that image was not used. No bespoke surveys or redistributed photographs.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:New_Mosque_View_from_SW_side_in_2024_5412.jpg",
        "date": "2024-05-26",
        "author": "Dosseman /Dick Osseman",
        "license": "CC-BY-SA-4.0 for photograph;building rights separate",
        "observed": "Actually inspected1280×853 roof close view:stepped cream stone buttresses/octagonal turrets,small ribbed lead-grey caps,larger cascading grey domes,dark projecting cornices and gold globe/crescent finials. Fine lead seams and carving are abstracted with shared materials and sparse geometry."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:New_Mosque_courtyard_general_view_in_2009_2674.jpg",
        "date": "2009-06-26",
        "author": "Dosseman /Dick Osseman",
        "license": "CC-BY-SA-4.0 for photograph;building rights separate",
        "observed": "Actually inspected1280×852 night courtyard:pointed arches on pale slim columns,alternating pale/warm voussoirs,low grey gallery domes,raised central prayer-hall portal,paired minarets and bulbous domed octagonal fountain with arched grille fields/ornamental crown. Lighting is not baked into the model;calligraphy and grille patterns are abstracted."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:New_Mosque_SW_side_in_2003_0708.jpg",
        "date": "2003-12-10",
        "author": "Dosseman /Dick Osseman",
        "license": "CC-BY-SA-4.0 for photograph;building rights separate",
        "observed": "Actually inspected1280×960 southwest exterior:two-storey open side gallery with broad lower round arches and narrower upper round arches,raised approach stairs,pale ashlar courses,stepped capped buttress turrets,windowed semi-dome drums and main windowed drum. Trees occlude some parts and the top/minarets are cropped;unseen geometry remains estimated."
      }
    ]
  }
