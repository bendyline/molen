    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Sarmizegetusa_Regia_-_sanctuarul_mare_circular,_panoramă_spre_NE.jpg",
        "author": "Andrei Lucian Vaida",
        "date": "2019-10-12",
        "license": "CC BY-SA4.0; viewed only",
        "observations": "Actually inspected northeast-facing panorama: low outer stone ring, modern rectangular timber posts around the inner circle and horseshoe, small stone ring, rectangular base rows, solar disc and terrace retaining traces. No full ancient temple roofs survive in this view."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Sarmizegetusa_Regia_-_panoramă_generală_spre_S.jpg",
        "author": "Andrei Lucian Vaida",
        "date": "2019-10-12",
        "license": "CC BY-SA4.0; viewed only",
        "observations": "Actually inspected south-facing broad view: terraced sanctuary ground, rectangular stone-base rows, small circular ring, large timber-post sanctuary, circular solar disc with long straight stone channel and low terrace walls. Individual counts and damage are approximate."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Sarmizegetusa_Regia_2011_-_East_Gate_Wall_Close_Up-1.jpg",
        "author": "Codrinb",
        "date": "2011-09-05",
        "license": "CC BY-SA3.0 Romania; viewed only",
        "observations": "Actually inspected wall closeup: low surviving coursed gray stone with broad blocks and uneven joints, surrounded by forest. No restored tall timber castle is implied by the retained coarse building/material tags."
      }
    ]
