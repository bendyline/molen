  "currentRoundInspection": {
    "inspectedOn": "2026-10-15",
    "scope": "Three useful Commons exterior, entrance and ferris-wheel photographs plus standard viewer PMTiles/DEM only. Photographs viewed only, not downloaded/redistributed. No bespoke drawings/surveys researched.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Front_of_Uspenski_Cathedral_In_Helsinki.jpg",
        "image": "https://upload.wikimedia.org/wikipedia/commons/c/c5/Front_of_Uspenski_Cathedral_In_Helsinki.jpg",
        "author": "John Samuel",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected2019 western entrance closeup: red brick tiers and round-arched recessed windows, paired wall colonettes, large upper round window, small gabled porch with open front and side arches, two warm grey granite columns and raised wood door/steps. Exact ornamental brick courses and doorway levels estimated. Viewed only, not redistributed."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Uspenski_Cathedral_from_above_-_2510.jpg",
        "image": "https://upload.wikimedia.org/wikipedia/commons/0/08/Uspenski_Cathedral_from_above_-_2510.jpg",
        "author": "DemieK07",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected22October2025 exterior from nearby ferris wheel: high central brick drum with tall round fields, tiered green copper helmet and small gold onion/cross, four medium roof turrets and eight smaller corner roof tips. South lower projecting vestibule/bell tower with conical copper roof, low side link and door. Round east apses and stepped hill/plinth visible. Standard map controls all footprints/heights; photograph guides silhouette/subdivision only."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Uspenski_Cathedral_2022.jpg",
        "image": "https://upload.wikimedia.org/wikipedia/commons/f/f1/Uspenski_Cathedral_2022.jpg",
        "author": "kallerna",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected22April2022 close exterior: large round-headed drum windows under nested brick arches, broad flared copper helmet with a narrower upper neck, gold onion and cross. Main cross arms have green gables, round upper windows and circular blind brick fields; smaller corner brick shafts carry steep green pyramids and tiny gold caps/crosses. Lower wall pairs of arched windows, chunky brick pilasters/cornices. Panel joints/tracery and ornament are approximate. Viewed only."
      }
    ]
