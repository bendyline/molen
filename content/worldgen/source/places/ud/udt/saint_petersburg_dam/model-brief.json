  "exportLabel": "Molen original Saint Petersburg flood barrier with S-1 and S-2",
  "expectedDraftMasterHash": "sha256:e9c58cb4c98a38639dd6415389a6f2b5e2b21530dc69702c73a275f9776262c0",
  "visualBrief": "Both maritime arms of the Saint Petersburg flood barrier, the six raised-gate sluice bridges, S-1 open navigation passage with parked sector gates and tunnel approaches, and the S-2 lift bridge and approach decks.",
  "heightPolicy": "The named A-118 carriageways and current PMTiles place the corridor and crossings. Official span and gate counts control the architecture. Width profiles and precise wall, gate housing and deck grades are visual estimates. Native Kotlin terrain and roads connect the two arms. Gates are static in the normal open position. The z12 regional field is coarser than a sluice opening. The operator section and centerline lengths describe different extents. Exact bathymetry, shoreline contact and hidden machinery are unverified. Physical-device and dense-scene timing remain unmeasured.",
  "nativeAxes": "+X trends NE from Bronka to Gorskaya along the two bent barrier arms. +Z is generally toward the inner Neva Bay side. +Y up.",
  "sourceFacts": {
    "length": 25400,
    "embankmentSections": 11,
    "sluices": 6,
    "sluiceBays": 64,
    "navigationPassages": 2,
    "lanes": 6,
    "mappedCenterlineMeters": 24395.33340373966,
    "modeledEmbankmentRuns": 10,
    "roadDatum": "sea-level",
    "roadDeck": 6.5,
    "terrainTiles": 52,
    "terrainGridStep": 112,
    "retainedNativeParts": 533,
    "ownedNativeParts": 0
  },
  "materialMethod": "Five shared 256px graphs for basalt, gravel, concrete, standing-seam metal and painted metal. Six near groups and one far palette group use metric UVs and linear color tints with zero embedded images.",
  "limitations": [
    "Both maritime arms of the Saint Petersburg flood barrier, the six raised-gate sluice bridges, S-1 open navigation passage with parked sector gates and tunnel approaches, and the S-2 lift bridge and approach decks.",
    "The named A-118 carriageways and current PMTiles place the corridor and crossings. Official span and gate counts control the architecture. Width profiles and precise wall, gate housing and deck grades are visual estimates. Native Kotlin terrain and roads connect the two arms. Gates are static in the normal open position. The z12 regional field is coarser than a sluice opening. The operator section and centerline lengths describe different extents. Exact bathymetry, shoreline contact and hidden machinery are unverified. Physical-device and dense-scene timing remain unmeasured."
  ],
