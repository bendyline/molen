  "currentRoundInspection": {
    "inspectedOn": "2026-10-16",
    "scope": "Three actually inspected exterior pictures and standard viewer PMTiles/DEM only. No bespoke surveys or redistributed photographs.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Kostel_sv._Mikuláše_-_Praha,_Staré_město_-_Staroměstské_náměstí.jpg",
        "author": "Eva Haunerová",
        "date": "2007-04-28",
        "license": "CC-BY-2.5 OR CC-BY-SA-3.0 OR GFDL-1.2+",
        "observed": "Inspected complete square-facing south elevation: pale Baroque church with two square towers flanking an articulated long facade,green flared lower helmets,black/open upper lanterns and green onion caps/slender gilded finials. Central many-sided pale drum has tall arched lights and a broad two-tier green bell roof with smaller pale lantern. Facade carries paired columns/pilasters,arched and oval fields,a central door,curved pediments and small dark statues. Red tiled side roofs and rounded east apse;foreground trees/neighboring houses excluded."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:West_facade_of_the_Church_of_Saint_Nicholas_in_Old_Town,_Prague_(4265).jpg",
        "author": "Gampe",
        "date": "2020-04-13",
        "license": "CC-BY-SA-4.0",
        "observed": "Inspected west secondary portal detail: rectangular dark blue-grey studded double door,pale stone frame and broken curved pediment around a small saint relief;wide shallow semicircular steps and simple railings between large pale wall pilasters. Faithful studs,sculpture/lettering and exact step rise remain abstracted or unverified."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Praha,_Staré_Město,_kostel_sv._Mikuláše,_apsida_01.jpg",
        "author": "Daniel Baránek",
        "date": "2010-05-30",
        "license": "CC-BY-SA-3.0",
        "observed": "Inspected east rounded apse: pale pink/cream plaster,large full-height pilasters and layered pale cornices,terracotta half-conical roof,arched/oval recessed glazing and a central framed saint niche. Lower small fields and ornate scroll/pediment frames;adjoining northern townhouse,street vehicles and people excluded. Tower/green copper crown behind confirms side relationship."
      }
    ],
    "rejectedReference": {
