  "currentRoundInspection": {
    "inspectedOn": "2026-10-18",
    "scope": "Specific principal Bulguksa compound exterior: sixteen mapped halls/galleries and western auxiliary buildings, two courts, higher Birojeon/Gwaneumjeon/Nahanjeon, both entrance stone stair bridges, Dabotap, Seokgatap and the small sarira stupa. The large373m religious park boundary is not one building and remains outside this model.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Lotus_Flower_Bridge_and_Seven_Treasure_Bridge_at_Bulguksa_in_Gyeongju,_Korea.jpg",
        "author": "Unknown author / Korea Copyright Commission",
        "license": "Public Domain; viewed only.",
        "date": "2009-11-09",
        "observations": "Western paired stone stair/landing structure, granite posts and rails, timber gate, dark tiled upturned eaves, muted red and green painted members. Stair supports and retaining courses are distinct from the roofed galleries."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Bulguksa-map.svg",
        "author": "Rémi Cormier",
        "license": "CC BY-SA 3.0; viewed only.",
        "date": "2007-02-15",
        "observations": "Ordinary visitor-style diagram, not a survey. Two principal courts, Daeungjeon and Museoljeon, the two pagodas, western Geuknakjeon court, Jahamun and Anyangmun, higher Birojeon/Gwaneumjeon and the western auxiliary buildings. Use for identity and approximate arrangement; normal map controls metric placement."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Daeungjeon,_Bulguksa_02.jpg",
        "author": "Bernard Gagnon",
        "license": "CC0; viewed only.",
        "date": "2022-10",
        "observations": "Main hall: broad grey hip-and-gable tile roof with raised corners, red timber posts, green bracket bands, muted yellow panel fields, low granite plinth and short stairs. Fine dancheong patterns and contemporary protective wall coverings are not copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Bulguksa_01.jpg",
        "author": "Bernard Gagnon",
        "license": "CC0; viewed only.",
        "date": "2022-10-06",
        "observations": "Cheongungyo/Baegungyo: two stone stair flights and intermediate landing, an actual open semicircular stone vault below the landing, granite rail posts and open timber gate above. Stair dimensions and arch profile remain picture/map approximations."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:%EA%B2%BD%EC%A3%BC_%EB%B6%88%EA%B5%AD%EC%82%AC_%EB%8B%A4%EB%B3%B4%ED%83%91.jpg",
        "author": "Asadal",
        "license": "CC BY-SA 4.0; viewed only.",
        "date": "2006-05-20",
        "observations": "Dabotap: four stair approaches to a square base, four open stone supports, a broad square cap with upper rail enclosure, smaller octagonal upper structure/roof and stacked finial rings. Nominal height10.4m from the ordinary article; exact relief and lion sculpture omitted."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Seokgatap_Pagoda.jpg",
        "author": "Bernard Gagnon",
        "license": "CC0; viewed only.",
        "date": "2022-10-06",
        "observations": "Seokgatap: two square base stages, three decreasing solid storeys with projecting low stone roofs and a tall ringed finial. Much simpler and more solid than Dabotap. Nominal8.2m from ordinary article; finial/body allocation remains an estimate."
      }
    ]
  }
