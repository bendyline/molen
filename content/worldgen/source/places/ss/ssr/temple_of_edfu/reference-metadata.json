  "currentRoundInspection": {
    "inspectedOn": "2026-10-18",
    "scope": "Specific Edfu exterior: twin battered pylons and open gateway, open forecourt and peristyle, raised column-fronted roofed hall, independently mapped rear roof ranges and enclosing passage wall. The separate southern mapped colonnaded building retains all fourteen column controls and rear wall controls. No generic archaeological-park mass substitutes for the temple.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Temple_Edfou_Egypte.jpg",
        "viewedAt": "https://en.wikipedia.org/wiki/Temple_of_Edfu#/media/File:Temple_Edfou_Egypte.jpg",
        "author": "Patrick.reb",
        "license": "CC BY-SA3.0; viewed only, no redistributed pixels.",
        "caption": "Temple of Edfu facade",
        "observations": "Two very tall battered sandstone pylon towers flank a lower projecting central gateway. The rectangular doorway is open through the facade. Concave projecting cornice bands crown the gateway and outer edges; tall narrow staff recesses and small rectangular openings break the tower faces. Small falcon figures stand on either side of the doorway. Large carved scenes are visible, but fine inscriptions and exact relief inventories are outside the medium-fi geometry scope."
      }
    ]
  }
