    "inspectedOn": "2026-10-19",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Dendera_7_977.PNG",
        "author": "Ijanderson977",
        "date": "2008-07",
        "license": "Public domain; viewed only",
        "observations": "Actually inspected full frontal picture: six large Hathor-headed columns, each with a broad face/ears and tall sistrum block; high closed side piers; horizontal lintel and flared cavetto cornice; lower screen walls, two raised entrance jambs and a deep open axial entrance. Warm sandstone and worn relief fields; no photograph used as a texture."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Mudbrick_compound_walls.JPG",
        "author": "Charlesdrakew",
        "date": "2007-02",
        "license": "Public domain; viewed only",
        "observations": "Actually inspected full roof-level photograph of the compound: high thick mudbrick enclosure with irregular eroded crest, broad earth/rubble slopes and an independent dressed-stone gateway with a large rectangular opening and cavetto cornice. The enclosure is not a perfect rectangle or a clean tourism-boundary extrusion."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Dendera_roof_overview.jpg",
        "author": "A. Parrot",
        "date": "2015-12-29",
        "license": "CC BY-SA4.0; viewed only",
        "observations": "Actually inspected full roof overview from the rear toward the high hypostyle roof. Lower terrace, low chapel/room walls, western stair doorway, diagonal upper stair and partial modern metal stair/rail are visible. The kiosk is outside the left frame; exact chapel partitions and crest damage remain approximate."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:26930-_Kiosk_on_the_roof_of_Temple_of_Hathor,_Dendera.jpg",
        "author": "Panegyrics of Granovetter",
        "date": "2020-12-21",
        "license": "CC BY-SA2.0; viewed only",
        "observations": "Actually inspected full southwest roof-kiosk image: small Hathor-headed colonnade, broad upper shrine blocks, heavy rectangular lintels/roof edge, low relief screen walls and raised central jambs. Surrounding terrace and stone parapet are present. No image pixels copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Roof_of_the_Hathor_Temple_at_Dendera_(IV).jpg",
        "author": "Kyera Giannini; published by ISAW",
        "date": "2009-03-06",
        "license": "CC BY2.0; viewed only",
        "observations": "Actually inspected capital close-up: substantial wig mass and cow-ear outline remain, but the central face is heavily defaced, without intact modeled eyes, nose or smile. The upper shrine block is chipped and contains a recessed vertical niche. Fine individual relief/damage patterns are not surveyed."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Roman_Mammisi_at_Dendera_(II).jpg",
        "author": "Kyera Giannini / ISAW",
        "date": "2009-03-06",
        "license": "CC BY2.0; viewed only",
        "observations": "Actually inspected during this continuous round. Roofed cella, central high entrance, heavy lintels, floral side capitals and broken screen walls. No pixels copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:26901-_Dendera_church_and_Mammisi_ruins.jpg",
        "author": "Panegyrics of Granovetter",
        "date": "2020-12-21",
        "license": "CC BY-SA2.0; viewed only",
        "observations": "Actually inspected during this continuous round. Roofless older mammisi and basilica ruins in front of the standing roofed Roman mammisi. No pixels copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Complesso_templare_di_Dendera.png",
        "author": "Madaki",
        "date": "2008",
        "license": "Public domain; viewed only",
        "observations": "Actually inspected during this continuous round. Unmeasured visitor schematic: relative axes and component positions only. No pixels copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Sacred_Lake_at_Dendera_(I).jpg",
        "author": "Kyera Giannini / ISAW",
        "date": "2009-03-06",
        "license": "CC BY2.0; viewed only",
        "observations": "Actually inspected during this continuous round. Dry palm-filled basin, stone coping/posts and descending steps. No blue water; individual palms are not reconstructed. No pixels copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:The_Temple_of_the_Birth_of_Isis_at_Dendera_(I).jpg",
        "author": "Kyera Giannini / ISAW",
        "date": "2009-03-06",
        "license": "CC BY2.0; viewed only",
        "observations": "Actually inspected during this continuous round. Standing masonry chamber, partial roof/cornice, high doorway and open court with column stumps. No pixels copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Dendera_Mammisi_Nektanebos_I._02.JPG",
