  "currentRoundInspection": {
    "inspectedOn": "2026-10-18",
    "scope": "Luxor principal exterior from ordinary pictures and standard PMTiles: distinct entrance wings, surviving obelisk, open courts, seven-pair colonnade, rear ranges, selected shrines and the independently mapped Abu el-Haggag mosque exterior. Fine reliefs, statue carving, hidden historic interiors and surveyed floors are omitted. Ordinary photographs viewed only; no redistributed image pixels or bespoke data research.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Luxor_temple_entrance.JPG",
        "image": "https://upload.wikimedia.org/wikipedia/commons/8/86/Luxor_temple_entrance.JPG",
        "author": "Ad Meskens",
        "date": "2011-08-10",
        "license": "CC BY-SA3.0;viewed only,no image pixels redistributed.",
        "observations": "Tall tapering square obelisk on a broad pedestal,unequal surviving battered pylon wings,real central passage,high square facade openings,paired seated statue silhouettes and projecting top cornices. Reliefs and statue carving are outside medium-fi scope."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:LuxorTempleColonnade.jpg",
        "image": "https://upload.wikimedia.org/wikipedia/commons/4/45/LuxorTempleColonnade.jpg",
        "author": "Roland Unger",
        "date": "2010-02-22",
        "license": "CC BY-SA3.0;viewed only,no image pixels redistributed.",
        "observations": "Seven tall columns along the visible side,wide flared papyrus capitals,rectangular upper beam,open gaps and lower surviving masonry. Pale warm sandstone;no complete roof reconstruction. Rear ranges and exact surviving inventories will remain map/picture-guided approximations."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Luxor_Temple_Mosque.jpg",
        "image": "https://upload.wikimedia.org/wikipedia/commons/4/48/Luxor_Temple_Mosque.jpg",
        "author": "Alyssa Bivins",
        "date": "2016-07-06",
        "license": "CC BY-SA4.0; viewed only, no pixels redistributed.",
        "observations": "Thin white minaret seen through ancient columns: balcony, tapered upper shaft, open lantern and rounded cap. Only a narrow view of the mosque."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Abu_el-Haggag_R03.jpg",
        "image": "https://upload.wikimedia.org/wikipedia/commons/b/b9/Abu_el-Haggag_R03.jpg",
        "author": "Marc Ryckaert (MJJR)",
        "date": "2011-01-29",
        "license": "CC BY3.0; viewed only, no pixels redistributed.",
        "observations": "Raised white mosque above the ancient court, pointed facade panels, crenellated parapet, stepped dome drum, cream dome, tall white balcony/lantern minaret and older tapered stone minaret. The separate square New Mosque minaret visible in the background is excluded."
      }
    ]
