  "currentRoundInspection": {
    "inspectedOn": "2026-10-15",
    "scope": "Two useful exterior2012/aerial2016 pictures plus standard viewer PMTiles/DEM. Photographs viewed only, not downloaded or redistributed. No bespoke surveys/plans researched; current finish/detail and plaza levels remain explicit limits.",
    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Catedral_Rio_de_Janeiro.jpg",
        "author": "Haakon S. Krohn",
        "date": "2012-03-31",
        "license": "CC-BY-SA-3.0",
        "observed": "Actually inspected whole exterior and bell tower. Broad tapered concrete frustum with shallow horizontal louver/grid tiers, thin vertical ribs and four wider sloping full-height bands. Gray-brown warm concrete and dark recessed openings; crown rim has small openings. Separate tapering open concrete campanile with repeated rectangular stages, suspended bells and slender cross; lower planting partially obscures bases."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Centro_do_Rio_de_Janeiro_by_Diego_Baravelli.jpg",
        "author": "Diego Baravelli",
        "date": "2016-12-10",
        "license": "CC-BY-SA-4.0",
        "observed": "Actually inspected aerial whole cathedral and detached campanile. Circular tapered body with four inset dark window axes continuing to a flat crown and cross-shaped pale skylight; gridded concrete quadrants. Main lower portal appears recessed and dark. Detached bell tower is west/northwest relative to main, agreeing with the separate map circle. Grounds/path and neighboring architecture are distinct. Exact entrance sculpture, stained-glass art and plaza levels are not resolved."
      }
    ]
  }
