    "pictures": [
      {
        "page": "https://commons.wikimedia.org/wiki/File:Masjid_Negara_and_its_minaret_(18790212558).jpg",
        "date": "2014-04-20",
        "author": "Jorge Láscar",
        "license": "CC-BY-2.0; viewed only",
        "observed": "Inspected complete 960×640 street exterior. Slender square pale minaret with projecting platform and tall folded pointed cap; broad low entrance canopy with fingered/scalloped edge and thin columns, raised approach and blue folded roof behind. Exact lettering, gardens, fixtures and fences not copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Majid_Negara_Kuala_Lumpur_Malaysia.jpg",
        "date": "2006-01-03",
        "author": "Philip Nalangan",
        "license": "CC-BY-4.0; viewed only",
        "observed": "Supplementary complete 960×719 detail of open geometric concrete star screen and pale broad beams. No full roof or plan control. Original coarse diamond screen rhythm is an approximation; fine screen artwork not copied."
      },
      {
        "page": "https://commons.wikimedia.org/wiki/File:Masjid_Negara_view_from_Kuala_Lumpur_Tower_2023.jpg",
        "date": "2023-03-29",
        "author": "Pangalau",
        "license": "CC-BY-SA-4.0; viewed only",
        "observed": "Inspected complete 960×652 elevated complex. Turquoise sixteen-point folded star umbrella roof with pale warm ribs, pale scalloped hall edge, slender minaret to the left and low white roof ranges with repeated shallow square caps. Open courts and columns visible. Detailed positions, heights, roof profiles and current finish remain estimates. Background city, separate roofed buildings and trees not copied."
      }
    ]
