      "new-surfaces.png": "sha256:2c94168ee72bf81fa9e4276ff1d95eedc83a1fc3f1aa8c6e6da093db0a46a015"
    },
    "notes": "Inspected the full 51-graph sheet and focused six-graph sheet. New white painted lap courses and green staggered shingles are distinct and repeat coherently. Timber grain aligns along U; canvas weave, intact metal paint and granite flecks remain restrained. Coarse construction patterns remain visible in the 3×3 repeated previews. Some legacy masonry patterns use stylized broad mortar and retain existing appearance."
  },
  "fidelityReview": {
    "target": "maximum",
    "status": "pending",
    "notes": "These are deterministic 256² procedural surfaces, not scans. Swatches show base color only. Tangent normals, metric orientation, physically scaled repeats and actual lighting require per-model rendered review. New painted shingles have regular widths; canvas yarn detail and granite microstructure are limited by the texture resolution. Unique local wear, murals and facade art remain model-specific."
  },
  "extractionReview": {
    "status": "complete",
    "audit": "texture-audit.json",
    "notes": "The initial 223-GLB source/runtime audit found zero embedded images and zero texture records; no bitmap extraction was applicable. Vertex-color PBR fallback and the existing 45 procedural graphs were preserved."
  }
