{
  "format": "molen/matgraph@1",
  "size": [256, 256],
  "seed": 124,
  "nodes": [
    { "id": "cells", "type": "worley", "params": { "scale": 7, "jitter": 0.9, "output": "f2-f1" } },
    {
      "id": "stones",
      "type": "ramp",
      "input": "cells",
      "params": {
        "stops": [
          { "t": 0, "color": "#a09e93" },
          { "t": 0.045, "color": "#b0afa3" },
          { "t": 0.09, "color": "#dedbd0" },
          { "t": 0.3, "color": "#ebe8dc" },
          { "t": 1, "color": "#dbd9ce" }
        ]
      }
    },
    { "id": "u", "type": "gradient", "params": { "kind": "linear", "angleDeg": 0 } },
    { "id": "v", "type": "gradient", "params": { "kind": "linear", "angleDeg": 90 } },
    {
      "id": "u-fold",
      "type": "ramp",
      "input": "u",
      "params": {
        "stops": [
          { "t": 0, "color": "#000000" },
          { "t": 0.5, "color": "#ff0000" },
          { "t": 1, "color": "#000000" }
        ]
      }
    },
    {
      "id": "v-fold",
      "type": "ramp",
      "input": "v",
      "params": {
        "stops": [
          { "t": 0, "color": "#000000" },
          { "t": 0.5, "color": "#00ff00" },
          { "t": 1, "color": "#000000" }
        ]
      }
    },
    {
      "id": "fold",
      "type": "blend",
      "inputs": { "a": "u-fold", "b": "v-fold" },
      "params": { "mode": "add", "factor": 1 }
    },
    { "id": "stretch", "type": "const", "params": { "value": [1, 1, 0, 1] } },
    {
      "id": "fiber-uv",
      "type": "blend",
      "inputs": { "a": "fold", "b": "stretch" },
      "params": { "mode": "multiply", "factor": 1 }
    },
    {
      "id": "fiber-noise",
      "type": "noise",
      "params": { "kind": "simplex", "octaves": 2, "scale": 14, "seedOffset": 31 },
      "input": "fiber-uv"
    },
    {
      "id": "fiber",
      "type": "levels",
      "input": "fiber-noise",
      "params": { "outMin": 0.9, "outMax": 1 }
    },
    {
      "id": "out",
      "type": "blend",
      "inputs": { "a": "stones", "b": "fiber" },
      "params": { "mode": "multiply", "factor": 1 }
    },
    { "id": "rough", "type": "const", "params": { "value": 0.98 } },
    {
      "id": "normal",
      "type": "height-to-normal",
      "input": "cells",
      "params": { "strength": 0.009 }
    }
  ],
  "outputs": { "baseColor": "out", "roughness": "rough", "normal": "normal" }
}
