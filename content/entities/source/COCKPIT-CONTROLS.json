{
  "date": "2026-10-24",
  "scope": "Physical cockpit controls for all 53 aircraft",
  "authoring": "Deterministic procedural geometry in the existing generators, with retained cockpit materials and textures. No external model or newly generated bitmap inputs.",
  "changes": [
    "Reuse and animate existing authored throttle, flap, engine and pedal controls where present; supply missing supported controls in attached lower instrument-panel modules.",
    "Add independent engine power and cutoff controls, shared power synchronization, gear, flaps, vector angle and airplane parking brake as supported by each aircraft specification.",
    "Store interaction and rest-relative motion in glTF extras so bindings survive the normal optimized asset import.",
    "Keep physical pointer interaction enabled by default and make the optional HTML companion panel opt-in."
  ],
  "validation": {
    "client": "442 tests in 53 files passed with --maxWorkers=2 --testTimeout=15000; client TypeScript check passed.",
    "fleet": "Source and runtime GLBs: all 53 aircraft have modeled, bound and ray-pickable controls for every supported action, including separate engine bindings. Both fleet tests passed.",
