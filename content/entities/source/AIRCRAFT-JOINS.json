{
  "date": "2026-10-24",
  "scope": "Curved aircraft surface joins and cockpit trim",
  "changes": [
    "Triangulate warped loft panels in 3D; project planar sheets in their geometric plane rather than an approximate winding hint.",
    "Preserve tapered pole triangles; join six-sided trim through shared miter rings instead of separate cylinder caps.",
    "Use a single panel/coaming/rail profile on Cessna 172S, Cessna 182T, Bonanza G36 and Baron G58.",
    "Join every MiG-29 canopy station to its body shoulders, close canopy-end crescents and wing-root gaps, bridge rectangular intake sections to rounded engine pods, close intake/nozzle lips and follow nozzle bends with petal seams.",
    "Join shared jet nacelle rims to recessed fan faces and exhaust disks.",
    "Restore P-51 and OH-6 texture/source manifests to match their unchanged prior cockpit models."
  ],
  "validation": {
    "aircraftTests": "134 tests across 17 files passed after restoring the two stale texture manifests; 132 passed initially, followed by all five cockpit-surface tests on rerun.",
    "regressionTests": "11 tests cover side-wall coverage, real sheet apertures, tapered nose closure, continuous trim, Cessna coaming joins and MiG-29 exhaust rims in source and imported GLBs.",
    "reproducibility": "All 50 regenerated aircraft source GLBs reproduced byte-for-byte in a second complete aircraft-only generation.",
    "integrity": "Verified all 50 source pins, imported source/runtime hashes and gallery cache hashes. CLI asset inspect --verify passed for both Cessnas and the MiG-29.",
    "catalog": "generate-models.mjs --check verified 198 entity source bundles.",
    "formatting": "Biome check passed for all changed generator and test modules.",
    "localPack": "Rebuilt only the entities pack for the local world explorer, using existing package builds."
  },
